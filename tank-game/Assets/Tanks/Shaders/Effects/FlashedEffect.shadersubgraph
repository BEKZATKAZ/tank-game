    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "float p = saturate(Progress);\nfloat hold = clamp(Hold, 0.0, 0.99);\nfloat recovery = saturate((p - hold) / max(1.0 - hold, 0.001));\nrecovery *= recovery;\nfloat strength = 1.0 - recovery * recovery * (3.0 - 2.0 * recovery);\nfloat2 drift = float2(0.85 + 0.15 * cos(p * 22.0), 0.15 * sin(p * 17.0));\nfloat2 shift = max(Offset, 0.0) * strength * drift;\nLeftUV = clamp(UV - shift, 0.000001, 0.999999);\nRightUV = clamp(UV + shift, 0.000001, 0.999999);\nExposure = lerp(1.0, max(Peak, 1.0), strength);\nWhite = 1.0 - smoothstep(hold, min(1.0, hold + max(Fade, 0.001)), p);"
}

