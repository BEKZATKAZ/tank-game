#Root {
	background-color: rgba(0, 0, 0, 0.99);
	flex-grow: 1;
	justify-content: center;
	align-items: center;
}

.dialog {
	min-width: 700px;
	overflow: hidden;
    background-image: var(--bg-image);
	-unity-background-image-tint-color: red;
}

.dialog-fill {
	flex-grow: 1;
	margin: 13px;
    background-image: var(--bg-image);
	-unity-background-image-tint-color: black;
}

.dialog-header {
	font-size: 32px;
	background-color: red;
	padding: 10px 30px;
	-unity-font-style: bold;
}

.dialog-message {
	font-size: 26px;
	padding: 30px;
}

.unity-button {
	padding: 10px 20px;
	border-width: 2px;
	flex-shrink: 0;
}

.dialog-buttons {
	margin: 10px 20px 20px 20px;
	flex-direction: row;
	justify-content: flex-end;
}

#YesButton, #NoButton {
	flex: 0 0 100px;
	margin-left: 10px;
}
