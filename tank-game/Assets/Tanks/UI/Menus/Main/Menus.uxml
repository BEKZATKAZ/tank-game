            </Tanks.UI.Elements.CustomButton>
            <Tanks.UI.Elements.CustomButton name="QuitButton" text="" style="background-image: url(&quot;project://database/Assets/Plugins/Layer%20Lab/2D%20Icons-PictoIconPack01/PictoIcon_256/Icon_PictoIcon_Quit.Png?fileID=21300000&amp;guid=eff50cd7d22a34292bdd2d83400f3312&amp;type=3#Icon_PictoIcon_Quit&quot;);">
