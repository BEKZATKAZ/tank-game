                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3244510153236480)"/>
                </Bindings>
            </Tanks.UI.Elements.CustomButton>
            <Tanks.UI.Elements.CustomButton name="SettingsButton" style="background-image: url(&quot;project://database/Assets/Plugins/Layer%20Lab/2D%20Icons-PictoIconPack01/PictoIcon_256/Icon_PictoIcon_Setting_1.Png?fileID=21300000&amp;guid=a8e1509e3881943cbafc9ee0bf954e81&amp;type=3#Icon_PictoIcon_Setting_1&quot;);">
