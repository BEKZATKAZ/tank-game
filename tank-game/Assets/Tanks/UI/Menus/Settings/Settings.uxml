<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Settings.uss"/>
    <Style src="BindingCaptureDialog.uss"/>
    <ui:VisualElement name="SettingsSection" class="settings-section" style="display: none;">
        <ui:VisualElement name="Settings" class="settings">
            <ui:ScrollView name="" horizontal-scroller-visibility="Hidden">
                <Tanks.UI.Menus.Settings.Elements.SettingDropdown choice-keys="ENGLISH,РУССКИЙ,FRANÇAIS" name="Language" type="Language">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(4793871635013632)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SettingDropdown>
                <ui:Label class="settings-category"><Bindings><UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="menu.settings.display"/></Bindings></ui:Label>
                <Tanks.UI.Menus.Settings.Elements.SettingScreenResolution name="ScreenResolution" type="ScreenResolutionIndex">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3717298093776896)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SettingScreenResolution>
                <Tanks.UI.Menus.Settings.Elements.SettingDropdown name="FullscreenMode" localize-choices="true" choice-keys="screen-fullscreen,screen-fullscreen-windowed,screen-windowed" type="FullscreenMode">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3714690427871232)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SettingDropdown>
                <Tanks.UI.Menus.Settings.Elements.SettingDropdown choice-keys="off,on" name="VerticalSync" localize-choices="true" type="VSync">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3701267455500288)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SettingDropdown>
                <Tanks.UI.Menus.Settings.Elements.SettingDropdown choice-keys="30 FPS,60 FPS,120 FPS,240 FPS" name="FrameLimit" localize-choices="false" type="FrameRateIndex" value="1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3713258257604608)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SettingDropdown>
                <ui:Label class="settings-category"><Bindings><UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="menu.settings.audio"/></Bindings></ui:Label>
                <Tanks.UI.Menus.Settings.Elements.SliderSetting type="MasterVolume" name="MasterVolume" enable-instant-preview="true">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3337205144051712)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SliderSetting>
                <Tanks.UI.Menus.Settings.Elements.SliderSetting type="MusicVolume" name="MusicVolume" enable-instant-preview="true">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3337490075705344)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SliderSetting>
                <Tanks.UI.Menus.Settings.Elements.SliderSetting type="SFXVolume" name="SFXVolume" enable-instant-preview="true">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3337645382393856)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SliderSetting>
                <Tanks.UI.Menus.Settings.Elements.SliderSetting type="UIVolume" name="UIVolume" enable-instant-preview="true">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3337773761650688)"/>
                    </Bindings>
                </Tanks.UI.Menus.Settings.Elements.SliderSetting>
                <ui:Label class="settings-category"><Bindings><UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="menu.settings.controls"/></Bindings></ui:Label>
                <Tanks.UI.Menus.Settings.Elements.SettingDropdown name="ControlsMode" localize-choices="true" choice-keys="modern,classic" type="ControlsMode">
                    <Bindings><UnityEngine.Localization.LocalizedString property="Label" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="menu.settings.controls"/></Bindings>
                </Tanks.UI.Menus.Settings.Elements.SettingDropdown>
                <ui:Label name="BindingStatus" class="binding-status"/>
                <ui:VisualElement name="ControlMappings"/>
            </ui:ScrollView>
            <ui:VisualElement name="Bottom" class="settings-bottom">
                <Tanks.UI.Elements.CustomButton name="ApplyButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3638632466833408)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="RevertButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3641288212045824)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="ResetToDefaultsButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(3638901065867264)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="BackButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(33779992972713984)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BindingCaptureOverlay" class="binding-dialog-overlay" style="display: none;">
            <ui:VisualElement class="binding-dialog">
                <ui:VisualElement class="binding-dialog__fill">
                    <ui:Label class="binding-dialog__header">
                        <Bindings><UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.settings.controls"/></Bindings>
                    </ui:Label>
                    <ui:Label name="BindingCapturePrompt" class="binding-dialog__prompt"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
