            </Bindings>
        </Tanks.UI.Elements.CustomButton>
    </ui:VisualElement>
    <ui:VisualElement name="PlaySection" picking-mode="Ignore" class="main-buttons" style="display: none;">
        <ui:Label name="GameTitle" class="game-title">
            <Bindings>
