    </ui:VisualElement>
    <ui:VisualElement name="StoreSection" picking-mode="Ignore" class="store-section" style="display: none;">
        <ui:VisualElement picking-mode="Ignore" class="store-header">
            <Tanks.UI.Elements.CustomButton name="BackButton">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.back"/>
                </Bindings>
            </Tanks.UI.Elements.CustomButton>
            <ui:Label picking-mode="Ignore" class="store-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.title"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="StoreRewards" picking-mode="Ignore" class="rewards-row" style="display: none;">
            <ui:VisualElement name="PlaytimeReward" class="reward-card">
                <ui:VisualElement picking-mode="Ignore" class="bg-fill"/>
                <ui:Label name="RewardTitle"/>
                <ui:Label name="RewardTimer" class="reward-timer"/>
                <Tanks.UI.Elements.CustomButton name="ClaimButton" class="claim-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.reward.claim"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
            <ui:VisualElement name="DailyReward" class="reward-card">
                <ui:VisualElement picking-mode="Ignore" class="bg-fill"/>
                <ui:Label name="RewardTitle"/>
                <ui:Label name="RewardTimer" class="reward-timer"/>
                <Tanks.UI.Elements.CustomButton name="ClaimButton" class="claim-button">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.reward.claim"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="store-cosmetics">
            <ui:VisualElement class="cosmetic-tabs">
                <Tanks.UI.Elements.CustomButton name="BodyTab">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.bodies"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="TurretTab">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.turrets"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
            <ui:Label name="CatalogLoading" style="display: none;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.loading"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="CatalogError" class="catalog-error" style="display: none;">
                <ui:Label>
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.catalog-error"/>
                    </Bindings>
                </ui:Label>
                <Tanks.UI.Elements.CustomButton name="RetryCatalog">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="menu.store.retry"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
            <ui:ScrollView mode="Horizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Hidden" class="cosmetic-scroll">
                <ui:VisualElement name="CosmeticGrid" class="cosmetic-grid"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="MenuBalances" picking-mode="Ignore" class="menu-balances" style="display: flex;">
        <ui:VisualElement picking-mode="Ignore" class="balance-row">
            <Tanks.UI.Elements.BalanceElement name="PartsBalance" border-color="#808080" class="balance--parts"/>
            <Tanks.UI.Elements.BalanceElement name="PrideBalance" border-color="#FFFF00" class="balance--pride"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="LobbyRoomSection" class="lobby-room-section" style="display: none;">
        <ui:VisualElement name="LobbyRoom" class="lobby-room">
            <ui:VisualElement name="Header" class="lobby-room__header">
                <ui:Label name="LobbyName" text="Example Name" class="lobby-room__name"/>
                <ui:Label text="J3WPNJ" name="LobbyCode" class="lobby-room__code"/>
            </ui:VisualElement>
            <ui:ScrollView name="LobbySettings" horizontal-scroller-visibility="Hidden" class="lobby-room__settings"/>
            <ui:Label text="Preparing server..." name="LobbyStatus" class="lobby-room__status"/>
            <ui:VisualElement name="Footer" class="lobby-room__footer">
                <Tanks.UI.Elements.CustomButton name="LeaveButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(5099162528342016)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="ReadyButton" text="READY"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Chat" class="lobby-chat" style="display: flex;">
            <ui:Label class="lobby-chat__title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(5085350316171264)"/>
                </Bindings>
            </ui:Label>
            <ui:ScrollView name="ChatMessages" horizontal-scroller-visibility="Hidden" class="lobby-chat__messages"/>
            <ui:VisualElement class="lobby-chat__composer">
                <ui:TextField name="ChatField" max-length="500" class="lobby-chat__field">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(5219211482193920)"/>
                    </Bindings>
                </ui:TextField>
                <Tanks.UI.Elements.CustomButton name="SendButton" class="lobby-chat__send">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(5086135213056000)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="LobbyBrowserSection" class="lobby-browser-section" style="display: none;">
        <ui:VisualElement name="LobbyBrowser" class="lobby-browser">
            <ui:VisualElement name="Fill" class="bg-fill"/>
            <ui:VisualElement name="Header" class="lobby-browser__header">
                <ui:TextField label="" placeholder-text="" name="SearchField" max-length="30" is-delayed="true">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(6608185362702336)"/>
                    </Bindings>
                </ui:TextField>
                <Tanks.UI.Elements.CustomButton name="RefreshButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(34409516232040448)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="BackButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(33779992972713984)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
            <ui:Label text="Found 3 lobbies!" name="LobbyStatus" picking-mode="Ignore" class="lobby-browser__status"/>
            <ui:ScrollView name="" horizontal-scroller-visibility="Hidden">
                <Tanks.UI.Menus.LobbyBrowser.JoinableLobby/>
                <Tanks.UI.Menus.LobbyBrowser.JoinableLobby/>
                <Tanks.UI.Menus.LobbyBrowser.JoinableLobby/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="LeaderboardsSection" class="leaderboards-section" style="display: none;">
        <ui:VisualElement name="Leaderboards" class="leaderboards">
            <ui:VisualElement name="LeaderboardFill" picking-mode="Ignore" class="bg-fill"/>
            <ui:VisualElement class="leaderboards__selectors">
                <ui:DropdownField name="LeaderboardMetric" label="" choices="" class="leaderboards__metric">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000000)"/>
                    </Bindings>
                </ui:DropdownField>
                <ui:DropdownField name="LeaderboardCategory" class="leaderboards__category">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="tooltip" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000001)"/>
                    </Bindings>
                </ui:DropdownField>
            </ui:VisualElement>
            <ui:VisualElement class="leaderboards__row leaderboards__headings">
                <ui:Label name="RankHeader">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000007)"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="leaderboards__flag"/>
                <ui:Label name="PlayerHeader">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000008)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label name="ScoreHeader">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000009)"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:Label name="LeaderboardStatus" class="leaderboards__status"/>
            <ui:ScrollView name="LeaderboardEntries" horizontal-scroller-visibility="Hidden" class="leaderboards__entries"/>
            <ui:Label name="OwnEntryLabel" class="leaderboards__own-label">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000010)"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="OwnEntry" class="leaderboards__own"/>
            <ui:VisualElement class="leaderboards__footer">
                <Tanks.UI.Elements.CustomButton name="PreviousPageButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000011)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <ui:Label name="LeaderboardPage" class="leaderboards__page"/>
                <Tanks.UI.Elements.CustomButton name="NextPageButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000012)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="RefreshButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000013)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="BackButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(42000000000000014)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="DebriefingSection" class="debriefing-section" style="display: none;">
        <ui:VisualElement class="debriefing-panel">
            <ui:Label name="DebriefingTitle" class="debriefing-title">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="debriefing.title"/>
                </Bindings>
            </ui:Label>
            <ui:Label name="DebriefingError" class="debriefing-error">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="debriefing.unavailable"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="DebriefingContent" class="debriefing-content">
                <ui:ScrollView name="DebriefingStats" horizontal-scroller-visibility="Hidden" class="debriefing-stats">
                    <ui:VisualElement name="DebriefingRows"/>
                </ui:ScrollView>
                <ui:VisualElement class="debriefing-progress-block">
                    <ui:VisualElement class="debriefing-levels">
                        <ui:Label name="DebriefingCurrentLevel"/>
                        <ui:Label name="DebriefingNextLevel"/>
                    </ui:VisualElement>
                    <ui:ProgressBar name="DebriefingProgress" low-value="0" high-value="1" focusable="false" picking-mode="Ignore" class="debriefing-progress"/>
                    <ui:Label name="DebriefingXP" class="debriefing-xp"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="debriefing-buttons">
                <Tanks.UI.Elements.CustomButton name="DebriefingSkip" click-sound-path="event:/UI/Click_1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="debriefing.skip"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
                <Tanks.UI.Elements.CustomButton name="DebriefingClose" click-sound-path="event:/UI/Click_1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="Menus" entry="debriefing.close"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ItemBrowserSection" class="item-browser-section" style="display: none;">
        <ui:VisualElement class="item-browser">
            <ui:VisualElement class="item-browser__header">
                <ui:Label class="game-title">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(36568010776682496)"/>
                    </Bindings>
                </ui:Label>
                <Tanks.UI.Elements.CustomButton name="BackButton" click-sound-path="event:/UI/Click_1">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:34510603f8b6d1a44b1b2ffa9aa551c9" entry="Id(33779992972713984)"/>
                    </Bindings>
                </Tanks.UI.Elements.CustomButton>
            </ui:VisualElement>
            <ui:VisualElement class="item-browser__body">
                <ui:ScrollView horizontal-scroller-visibility="Hidden" class="item-browser__scroll">
                    <ui:VisualElement name="ItemGrid" class="item-browser__grid"/>
                </ui:ScrollView>
                <ui:ScrollView horizontal-scroller-visibility="Hidden" class="item-browser__details-scroll">
                    <ui:VisualElement name="ItemDetails" class="item-browser__details" style="visibility: hidden;">
                        <ui:VisualElement name="Fill" picking-mode="Ignore" class="bg-fill"/>
                        <ui:VisualElement class="item-browser__detail-header">
                            <ui:VisualElement name="ItemIcon" class="item-browser__icon"/>
                            <ui:Label name="ItemName" enable-rich-text="false" class="item-browser__name"/>
                        </ui:VisualElement>
                        <ui:Label name="ItemDescription" class="item-browser__description"/>
                        <ui:Label name="ItemTier" enable-rich-text="false" class="item-browser__tier"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="Settings" name="SettingsContainer" style="flex-grow: 1; display: none;"/>
    <ui:Label name="LoadingLabel" picking-mode="Ignore" class="loading-label" style="display: none;"/>
</ui:UXML>
