    <ui:VisualElement name="MenuPlayerNames" picking-mode="Ignore" class="player-names"/>
    <Tanks.UI.Elements.CopyrightNotice name="Notice"/>
    <ui:VisualElement name="MainSection" picking-mode="Ignore" class="main-buttons" style="display: flex;">
        <ui:Label text="T.A.N.K.S." name="GameTitle" class="game-title"/>
        <Tanks.UI.Elements.CustomButton name="PlayButton" click-sound-path="event:/UI/Click_1">
