.unity-base-dropdown__label {
    font-size: 22px;
}

.reward-card #RewardTitle {
    white-space: normal;
    flex-grow: 1;
}

.item-browser-section {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.75);
}

.item-browser {
    width: 90%;
    max-width: 1400px;
    height: 85%;
}

.item-browser__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.item-browser__header .game-title {
    margin: 0;
}

.item-browser__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.item-browser__scroll {
    width: 776px;
    min-width: 776px;
    flex-shrink: 0;
}

.item-browser__grid {
    width: 756px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.item-browser__box {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    margin-right: 12px;
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
}

.item-browser__icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.item-browser__details-scroll {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 24px;
}

.item-browser__details {
    padding: 32px;
}

.item-browser__detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.item-browser__name {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 20px;
    font-size: 34px;
    letter-spacing: 2px;
    white-space: normal;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.item-browser__description, .item-browser__tier {
    font-size: 22px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.item-browser__tier {
    margin-top: 24px;
    -unity-font-style: bold;
}

.leaderboards-section {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.75);
}

.leaderboards {
    width: 90%;
    max-width: 1100px;
    height: 80%;
    max-height: 800px;
    padding: 30px;
    filter: drop-shadow(0 0 20 black);
    align-self: center;
}

.leaderboards__selectors {
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
    margin-bottom: 15px;
}

.leaderboards__metric, .leaderboards__category {
    -unity-text-align: middle-left;
}

.leaderboards__metric {
    width: 360px;
    max-width: 60%;
}

.leaderboards__category {
    width: 250px;
    max-width: 35%;
}

.leaderboards .unity-popup-field {
    font-size: 22px;
    min-height: 50px;
    flex-grow: 0;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    background-image: var(--bg-image);
    background-color: transparent;
    -unity-background-image-tint-color: var(--bg);
}

.leaderboards .unity-popup-field__input {
    min-width: 0;
    margin: 0;
    padding: 0 12px;
    border-width: 0;
    background-image: none;
    background-color: transparent;
    flex-direction: row;
    align-items: center;
}

.leaderboards .unity-base-popup-field__text {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.leaderboards .unity-base-popup-field__arrow {
    display: flex;
    width: 12px;
    min-width: 12px;
    height: 8px;
    min-height: 8px;
    flex-shrink: 0;
    margin: 0 8px;
    -unity-background-image-tint-color: var(--text-color);
}

.leaderboards .unity-popup-field.menu-highlighted:enabled {
    -unity-background-image-tint-color: var(--text-color);
}

.leaderboards .unity-popup-field.menu-highlighted:enabled .unity-base-popup-field__text {
    color: black;
}

.leaderboards .unity-popup-field.menu-highlighted:enabled .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: black;
}

.leaderboards__row {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
    flex-shrink: 0;
    padding: 4px 10px;
    margin-bottom: 3px;
}

.leaderboards__row Label {
    font-size: 22px;
    letter-spacing: 1px;
    word-spacing: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboards__row #Rank,
.leaderboards__row #RankHeader {
    width: 85px;
    flex-shrink: 0;
}

.leaderboards__flag {
    width: 48px;
    height: 28px;
    flex-shrink: 0;
    margin: 0 20px;
    -unity-background-image-tint-color: white;
}

.leaderboards__flag--unknown {
    background-color: var(--bg);
    border-width: 1px;
    border-color: var(--text-secondary-color);
}

.leaderboards__row #PlayerName,
.leaderboards__row #PlayerHeader {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
}

.leaderboards__row #Score,
.leaderboards__row #ScoreHeader {
    width: 230px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.leaderboards__row--local {
    background-color: var(--bg);
}

.leaderboards__headings {
    opacity: 0.6;
}

.leaderboards__entries {
    flex-grow: 1;
    min-height: 0;
}

.leaderboards__own {
    flex-shrink: 0;
    min-height: 42px;
}

.leaderboards__status,
.leaderboards__own-label {
    flex-shrink: 0;
    font-size: 20px;
    letter-spacing: 1px;
    margin: 5px 0;
}

.leaderboards__footer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-top: 15px;
}

.leaderboards__footer .unity-button {
    flex-grow: 1;
    padding: 10px;
    margin: 0 4px;
    font-size: 22px;
    letter-spacing: 1px;
}

.leaderboards__page {
    min-width: 90px;
    font-size: 20px;
    letter-spacing: 1px;
}

.main-buttons {
    flex-grow: 1;
    justify-content: center;
    align-self: center;
    min-width: 400px;
    padding-bottom: 40px;
}

.main-buttons * {
    margin: 5px 0 5px 0;
    transition: font-size 0.1s ease-out-back;
}

.main-buttons *.menu-highlighted:enabled {
    font-size: 40px;
}

.game-title {
    -unity-font-style: bold;
    font-size: 80px;
}

.notice {
    position: absolute;
    opacity: 0.2;
    bottom: 0;
    left: 0;
    margin: 15px 30px;
    font-size: 20px;
}

.settings-section {
    flex-grow: 1;
    justify-content: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.settings {
    min-width: 800px;
    align-self: center;
}

.settings-bottom {
    flex-direction: row;
    margin-top: 40px;
}

.settings-bottom * {
    margin: 0 5px;
    flex: 1 0 auto;
}

.setting {
    flex-direction: row;
    flex-grow: 1;
    margin: 5px 0;
    height: 70px;
}

.setting__label {
    width: 400px;
    -unity-text-align: middle-left;
}

.setting-dropdown__value {
    flex: 1 0 auto;
    width: 360px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.setting .unity-base-slider {
    flex-grow: 1;
    background-image: none;
    background-color: transparent;
    filter: none;
    margin: 0;
    padding: 0;
}

.setting .unity-base-slider > .setting__label {
    flex-shrink: 0;
}

.setting .unity-base-slider .unity-base-slider__input {
    flex-grow: 1;
    min-width: 320px;
    margin: 0;
    background-image: none;
    background-color: transparent;
    align-self: center;
    height: 30px;
}

.setting .unity-base-slider__tracker {
    background-color: var(--bg);
    top: 50%;
    height: 4px;
    margin-top: -2px;
}

.setting .unity-base-slider__dragger {
    top: 50%;
    width: 20px;
    height: 20px;
    margin-top: -10px;
}

.setting .unity-base-slider.menu-highlighted:enabled .unity-base-slider__tracker,
.setting .unity-base-slider:focus:enabled .unity-base-slider__tracker {
    background-color: var(--text-color);
}

.setting .unity-base-slider.menu-highlighted:enabled .unity-base-slider__dragger,
.setting .unity-base-slider:focus:enabled .unity-base-slider__dragger {
    background-color: var(--text-color);
    -unity-background-image-tint-color: var(--text-color);
    scale: 1.2 1.2;
}

.setting.menu-highlighted:enabled > .setting__label,
.setting .unity-base-slider.menu-highlighted:enabled .setting__label,
.setting .unity-base-slider:focus:enabled .setting__label {
    -unity-font-style: bold;
}

.lobby-browser-section {
    flex-grow: 1;
    justify-content: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.lobby-browser {
    min-width: 1100px;
    min-height: 700px;
    padding: 30px;
    filter: drop-shadow(0 0 20 rgb(0, 0, 0));
    align-self: center;
}

.lobby-browser__header {
    flex-direction: row;
}

.lobby-browser__header .unity-base-field {
    flex: 1 0 auto;
}

.lobby-browser__header .unity-button {
    margin-left: 10px;
}

.lobby-browser__status {
    color: var(--text-secondary-color);
    margin: 30px 0 5px 0;
}

.lobby-browser .unity-scroll-view {
    flex-grow: 1;
    padding: 10px;
}

.lobby {
    flex-direction: row;
    margin-bottom: 20px;
}

.lobby .unity-button {
    margin-left: 20px;
}

.lobby-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 28px;
}

.lobby-member-count {
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    font-size: 26px;
}

.lobby-room-section {
    flex-grow: 1;
    flex-direction: row;
}

.lobby-room {
    flex-grow: 1;
    align-self: stretch;
    margin: 50px;
    margin-right: 480px;
    max-width: 1000px;
    flex-shrink: 1;
    width: 1000px;
    overflow: visible;
    background-image: var(--bg-image);
    -unity-background-image-tint-color: var(--bg-dark);
}

.lobby-chat {
    position: absolute;
    right: 50px;
    bottom: 50px;
    width: 520px;
    height: 320px;
    max-width: 45%;
    padding: 20px;
    background-image: var(--bg-image);
    -unity-background-image-tint-color: var(--bg-dark);
    opacity: 0.5;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.lobby-chat--focused {
    opacity: 1;
}

.lobby-chat__title {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin: 6px 10px;
}

.lobby-chat__messages {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 6px;
}

.chat-message {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.chat-message > .unity-label {
    white-space: normal;
    -unity-text-align: upper-left;
}

.chat-server-message > .unity-label {
    color: var(--text-secondary-color);
    font-size: 20px;
}

.lobby-chat__composer {
    flex-direction: row;
    flex-shrink: 0;
}

.lobby-chat__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 4px 8px;
    margin-right: 6px;
}

.lobby-chat__field .unity-text-field__input {
    -unity-text-align: middle-left;
}

.lobby-chat__send,
.lobby-chat__send.menu-highlighted:enabled {
    flex-shrink: 0;
}

.lobby-room__name {
    flex-grow: 1;
    font-size: 32px;
    -unity-text-align: middle-left;
}

.lobby-room__code {
    font-size: 30px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.lobby-room__header {
    padding: 30px;
    flex-direction: row;
    background-color: black;
}

.lobby-room__footer {
    flex-direction: row;
    padding: 20px;
}

.lobby-room__footer * {
    flex: 1 0 200px;
    margin: 0 4px;
}

.lobby-room__settings {
    flex-grow: 1;
    padding: 10px 20px;
}

.lobby-room__status {
    margin-top: 10px;
}

.lobby-room__setting {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 70px;
    padding: 0 16px;
    align-items: center;
}

.lobby-room__setting .setting-dropdown__value {
    width: auto;
}

.lobby-room__setting:disabled {
    opacity: 0.5;
}

.loading-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 32px;
    width: 100%;
    height: 100%;
    position: absolute;
}

.menu-balances {
    position: absolute;
    right: 24px;
    top: 20px;
    align-items: flex-end;
}

.balance-row {
    flex-direction: row;
}

.currency-box {
    flex-direction: row;
    align-items: center;
    padding: 12px 20px;
    margin-left: 12px;
    min-width: 220px;
}

.currency-box > .unity-label {
    font-size: 38px;
}

.currency-icon {
    width: 48px;
    height: 48px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.currency-icon--parts,
.balance--parts .currency-icon {
    background-image: url("project://database/Assets/Tanks/Art/UI/Currency_SpareParts.png?fileID=21300000&guid=b48e5d3accfca7b4d897682a2d9a1621&type=3#Currency_SpareParts");
}

.currency-icon--pride,
.balance--pride .currency-icon {
    background-image: url("project://database/Assets/Tanks/Art/UI/Currency_Pride.png?fileID=21300000&guid=2f3f2e60e0041804ea2557bace082df8&type=3#Currency_Pride");
}

.currency-tooltip {
    position: absolute;
    top: 100%;
    right: 0;
    width: 450px;
    margin-top: 12px;
    padding: 20px 30px;
}

.currency-tooltip__title {
    -unity-text-align: upper-left;
    font-size: 28px;
    margin-bottom: 12px;
}

.currency-tooltip__description {
    white-space: normal;
    -unity-text-align: upper-left;
    margin-bottom: 6px;
}

.store-section {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 100px;
    bottom: 16px;
}

.store-header {
    height: 64px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.store-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 40px;
}

.rewards-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 80px;
    flex-direction: row;
    justify-content: center;
}

.reward-card {
    width: 340px;
    padding: 16px;
    margin-left: 8px;
    margin-right: 8px;
}

.reward-timer {
    margin-top: 8px;
    margin-bottom: 12px;
    font-size: 32px;
}

.claim-button {
    -unity-background-image-tint-color: rgb(190, 30, 30);
    margin-top: auto;
}

.claim-button:disabled {
    -unity-background-image-tint-color: rgb(90, 90, 90);
    color: rgb(170, 170, 170);
}

.claim-button.menu-highlighted:enabled {
    -unity-background-image-tint-color: rgb(255, 50, 50);
    color: white;
}

.store-cosmetics {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}

.cosmetic-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.cosmetic-tabs .unity-button {
    padding: 8px 20px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 30px;
}

.cosmetic-tabs .selected-tab {
    -unity-background-image-tint-color: rgb(170, 150, 50);
}

.cosmetic-scroll {
    height: 304px;
    flex-grow: 0;
    flex-shrink: 0;
}

.cosmetic-grid {
    height: 280px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
}

.cosmetic-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-start;
}

.cosmetic-card {
    width: 280px;
    min-width: 280px;
    height: 280px;
    flex-shrink: 0;
    padding: 12px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
}

.cosmetic-card .unity-label {
    white-space: nowrap;
    letter-spacing: 0;
    word-spacing: 0;
}

.cosmetic-title {
    height: 34px;
    -unity-text-align: middle-center;
    font-size: 30px;
}

.cosmetic-preview {
    flex-grow: 1;
    min-height: 80px;
    margin-top: 8px;
    margin-bottom: 12px;
}

.cosmetic-actions {
    min-height: 104px;
    flex-shrink: 0;
    justify-content: flex-end;
    margin-top: auto;
}

.cosmetic-card .unity-button {
    filter: none;
    min-height: 48px;
    padding: 8px 10px;
    margin: 0;
    flex-shrink: 0;
    font-size: 26px;
    letter-spacing: 0;
    word-spacing: 0;
    white-space: nowrap;
}

.purchase-column {
    flex-direction: column;
    flex-wrap: nowrap;
    flex-shrink: 0;
}

.cosmetic-card .purchase-button--spaced {
    margin-top: 4px;
}

.cosmetic-card .purchase-button {
    flex-grow: 1;
    flex-basis: auto;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.purchase-button .currency-icon {
    width: 36px;
    height: 36px;
    min-width: 36px;
    flex-shrink: 0;
    margin-right: 8px;
}

.cosmetic-card .purchase-price {
    flex-shrink: 0;
    font-size: 26px;
    white-space: nowrap;
}

.cosmetic-card .purchase-original-price {
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 18px;
    color: var(--text-secondary-color);
    white-space: nowrap;
}

.purchase-button.menu-highlighted:enabled .purchase-price {
    color: black;
}

.cosmetic-card #Discount {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 22px;
    color: yellow;
}

.catalog-error {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.catalog-error .unity-label {
    white-space: normal;
}
