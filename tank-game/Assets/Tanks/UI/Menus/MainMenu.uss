.main-buttons {
    flex-grow: 1;
    justify-content: center;
    align-self: center;
    min-width: 400px;
}

.main-buttons * {
    margin: 5px 0 5px 0;
    transition: font-size 0.1s ease-out-back;
}

.main-buttons *.menu-highlighted:enabled {
    font-size: 40px;
}

.game-title {
    -unity-font-style: bold;
    font-size: 80px;
}

.notice {
    opacity: 0.2;
    top: 5px;
    font-size: 22px;
}

.settings-section {
    flex-grow: 1;
    justify-content: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.settings {
    min-width: 800px;
    align-self: center;
}

.settings-bottom {
    flex-direction: row;
    margin-top: 40px;
}

.settings-bottom * {
    margin: 0 5px;
    flex: 1 0 auto;
}

.setting {
    flex-direction: row;
    flex-grow: 1;
    margin: 5px 0;
    height: 70px;
}

.setting__label {
    width: 400px;
    -unity-text-align: middle-left;
}

.setting-dropdown__value {
    flex: 1 0 auto;
    width: 360px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.setting .unity-base-slider {
    flex-grow: 1;
    background-image: none;
    background-color: transparent;
    filter: none;
    margin: 0;
    padding: 0;
}

.setting .unity-base-slider > .setting__label {
    flex-shrink: 0;
}

.setting .unity-base-slider .unity-base-slider__input {
    flex-grow: 1;
    min-width: 320px;
    margin: 0;
    background-image: none;
    background-color: transparent;
    align-self: center;
    height: 30px;
}

.setting .unity-base-slider__tracker {
    background-color: var(--bg);
    top: 50%;
    height: 4px;
    margin-top: -2px;
}

.setting .unity-base-slider__dragger {
    top: 50%;
    width: 20px;
    height: 20px;
    margin-top: -10px;
}

.setting .unity-base-slider.menu-highlighted:enabled .unity-base-slider__tracker,
.setting .unity-base-slider:focus:enabled .unity-base-slider__tracker {
    background-color: var(--text-color);
}

.setting .unity-base-slider.menu-highlighted:enabled .unity-base-slider__dragger,
.setting .unity-base-slider:focus:enabled .unity-base-slider__dragger {
    background-color: var(--text-color);
    -unity-background-image-tint-color: var(--text-color);
    scale: 1.2 1.2;
}

.setting.menu-highlighted:enabled > .setting__label,
.setting .unity-base-slider.menu-highlighted:enabled .setting__label,
.setting .unity-base-slider:focus:enabled .setting__label {
    -unity-font-style: bold;
}

.lobby-browser-section {
    flex-grow: 1;
    justify-content: center;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.75);
}

.lobby-browser {
    min-width: 1100px;
    min-height: 700px;
    padding: 30px;
    filter: drop-shadow(0 0 20 rgb(0, 0, 0));
    align-self: center;
}

.lobby-browser__header {
    flex-direction: row;
}

.lobby-browser__header .unity-base-field {
    flex: 1 0 auto;
}

.lobby-browser__header .unity-button {
    margin-left: 10px;
}

.lobby-browser__status {
    color: var(--text-secondary-color);
    margin: 30px 0 5px 0;
}

.lobby-browser .unity-scroll-view {
    flex-grow: 1;
    padding: 10px;
}

.lobby {
    flex-direction: row;
    margin-bottom: 20px;
}

.lobby .unity-button {
    margin-left: 20px;
}

.lobby-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 28px;
}

.lobby-member-count {
    -unity-text-align: middle-right;
    -unity-font-style: bold;
    font-size: 26px;
}

.lobby-room-section {
    flex-grow: 1;
    flex-direction: row;
}

.lobby-room {
    flex-grow: 1;
    align-self: stretch;
    margin: 50px;
    margin-right: 480px;
    max-width: 1000px;
    flex-shrink: 1;
    width: 1000px;
    overflow: visible;
    background-image: var(--bg-image);
    -unity-background-image-tint-color: var(--bg-dark);
}

.lobby-chat {
    position: absolute;
    right: 50px;
    bottom: 50px;
    width: 520px;
    height: 320px;
    max-width: 45%;
    padding: 20px;
    background-image: var(--bg-image);
    -unity-background-image-tint-color: var(--bg-dark);
    opacity: 0.5;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.lobby-chat--focused {
    opacity: 1;
}

.lobby-chat__title {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin: 6px 10px;
}

.lobby-chat__messages {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 6px;
}

.chat-message {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.chat-message > .unity-label {
    white-space: normal;
    -unity-text-align: upper-left;
}

.chat-server-message > .unity-label {
    color: var(--text-secondary-color);
    font-size: 20px;
}

.lobby-chat__composer {
    flex-direction: row;
    flex-shrink: 0;
}

.lobby-chat__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 4px 8px;
    margin-right: 6px;
}

.lobby-chat__field .unity-text-field__input {
    -unity-text-align: middle-left;
}

.lobby-chat__send, .lobby-chat__send.menu-highlighted:enabled {
    flex-shrink: 0;
}

.lobby-room__name {
    flex-grow: 1;
    font-size: 32px;
    -unity-text-align: middle-left;
}

.lobby-room__code {
    font-size: 30px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.lobby-room__header {
    padding: 30px;
    flex-direction: row;
    background-color: black;
}

.lobby-room__footer {
    flex-direction: row;
    padding: 20px;
}

.lobby-room__footer * {
    flex: 1 0 200px;
    margin: 0 4px;
}

.lobby-room__settings {
    flex-grow: 1;
    padding: 10px 20px;
}

.lobby-room__status {
    margin-top: 10px;
}

.lobby-room__setting {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 70px;
    padding: 0 16px;
    align-items: center;
}

.lobby-room__setting .setting-dropdown__value {
    width: auto;
}

.lobby-room__setting:disabled {
    opacity: 0.5;
}

.loading-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 32px;
    width: 100%;
    height: 100%;
    position: absolute;
}
