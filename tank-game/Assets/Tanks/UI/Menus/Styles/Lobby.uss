#Root {
	flex-grow: 1;
	flex-direction: row;
	padding: 40px 80px;
}

#PlayerList {
	flex-shrink: 0;
	flex-grow: 0;
	width: 800px;
	height: 100%;
	margin-right: 20px;
}

#LobbyNameField .unity-base-field__input {
	background-color: transparent;
	border-width: 0;
}

#LobbyNameField .unity-text-element {
	padding: 15px 20px 15px 30px;
	-unity-font-definition: var(--font-black);
}

#LobbyNameEditButton {
	-unity-background-image-tint-color: var(--text-color);
	border-width: 0;
	padding: 0;
	width: 64px;
	height: 64px;
	flex-shrink: 0;
	flex-grow: 0;
}

#PlayerCount {
	padding: 15px 30px;
	flex-shrink: 0;
	margin-left: auto;
	-unity-font-definition: var(--font-black);
}

#PlayerListContent {
	padding: 15px 30px;
}

.window {
	overflow: hidden;
	background-color: var(--bg-dark);
	border-radius: 10px;
	flex-grow: 1;
	border-width: 4px;
}

.window-header {
	flex-direction: row;
	align-items: center;
	font-size: 48px;
	-unity-text-align: middle-center;
}

.lobby-player {
	flex-direction: row;
	padding: 10px;
	margin-bottom: 15px;
	background-color: rgba(255, 255, 255, 0.01);
	-unity-text-align: middle-left;
}

.lobby-player__username {
	font-size: 32px;
}

#Chat .window-header .unity-label {
	padding: 15px 30px;
	-unity-text-align: middle-center;
	-unity-font-definition: var(--font-black);
	flex-grow: 1;
}

#ChatMessages {
	flex-grow: 1;
	padding: 16px 32px;
}

.chat-message {
	font-size: 24px;
	margin-bottom: 10px;
}

.chat-server-message .unity-label {
	color: gray;
}

.chat-message .unity-label {
	white-space: normal;
	letter-spacing: 1px;
	flex-shrink: 1;
}

#ChatFieldContainer {
	flex-direction: row;
	flex-shrink: 0;
	margin: 20px;
	border-width: 2px;
	border-radius: 5px;
}

#ChatSendButton {
	padding: 32px 42px;
	border-radius: 0;
	border-width: 0 0 0 2px;
	background-position-x: 50%;
}

#ChatField {
	flex-grow: 1;
	font-size: 32px;
}

#ChatField .unity-base-field__input {
	background-color: var(--bg);
	border-width: 0;
	padding: 12px 24px;
}

#LobbyButtons {
	flex-direction: row;
	font-size: 48px;
	margin-top: 20px;
}

#LobbyButtons * {
	flex-grow: 1;
}

#LobbyButtons #StartButton {
	margin-left: 20px;
}
