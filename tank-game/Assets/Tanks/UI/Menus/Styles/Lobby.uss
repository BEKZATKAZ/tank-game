#Root {
    flex-grow: 1;
    align-items: center;
    align-content: center;
    justify-content: center;
}

.lobby-container {
    border-width: 5px;
    border-radius: 20px;
    border-color: var(--text-color);
    background-color: rgba(0, 0, 0, 0.8);
    width: 800px;
}

.lobby__header {
    flex-direction: row;
    padding: 10px;
    margin-top: 10px;
}

.lobby__header * {
    flex: 1 0 250px;
    background-position-x: 50%;
    padding: 30px;
    margin: 0 5px 0 5px;
    border-width: 2px;
    -unity-background-image-tint-color: var(--text-color);
}

.lobby__section {
    padding: 20px;
}

.lobby__main-list {
    flex-grow: 1;
}

.lobby__bottom {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 20px;
}

.lobby__main-bottom {
    margin: 20px -10px 0 -10px;
}

.lobby__main-bottom * {
    flex-grow: 1;
    border-width: 2px;
    margin: 0 5px 0 5px;
}

.lobby__name {
    margin-bottom: 40px;
    font-size: 32px;
}

.lobby__status {
    margin-top: 40px;
    font-size: 32px;
}

.lobby-player {
    flex-direction: row;
    padding: 15px 20px;
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-left;
}

.lobby-player__username {
    font-size: 32px;
    flex-grow: 1;
}

.lobby-player__readiness {
    font-size: 24px;
    -unity-text-align: middle-right;
}

.chat-message {
    font-size: 24px;
    padding: 5px 10px;
    width: 100%;
    min-width: 0;
    align-self: stretch;
}

.lobby-chat .unity-scroll-view {
    max-height: 300px;
}

.chat-server-message .unity-label {
    color: gray;
}

.chat-message .unity-label {
    white-space: normal;
    letter-spacing: 1px;
    flex-shrink: 1;
    min-width: 0;
}

.chat__field-container {
    flex-direction: row;
    flex-shrink: 0;
    border-width: 2px;
    border-radius: 5px;
}

.chat__send-button {
    padding: 32px 42px;
    border-radius: 0;
    border-width: 0 0 0 2px;
    background-position-x: 50%;
}

.chat__field {
    flex-grow: 1;
    font-size: 32px;
}

.chat__field .unity-base-field__input {
    background-color: var(--bg);
    border-width: 0;
    padding: 12px 24px;
}
