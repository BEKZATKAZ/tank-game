.player-names {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.player-name {
    position: absolute;
    translate: -50% -100%;
    padding-bottom: 8px;
    max-width: 260px;
    font-size: 32px;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-shadow: 5px 5px 0 rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.player-ready-check {
    position: absolute;
    translate: -50% -50%;
    scale: 3 3;
    width: 26px;
    height: 24px;
}



.menu-player-name-row {
    position: absolute;
    translate: -50% -100%;
    flex-direction: row;
    align-items: center;
    padding-bottom: 8px;
}

.menu-player-name-row .player-name {
    position: relative;
    translate: 0 0;
    padding-bottom: 0;
    min-width: 0;
    flex-shrink: 1;
}

.menu-player-level {
    flex-shrink: 0;
    margin-right: 12px;
    min-width: 36px;
    padding: 4px 6px;
    background-color: rgb(24, 24, 24);
    border-color: yellow;
    border-width: 2px;
    font-size: 24px;
    letter-spacing: 0;
}
