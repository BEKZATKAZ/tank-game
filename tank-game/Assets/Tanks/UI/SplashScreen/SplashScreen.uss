:root {
	background-color: black;
	justify-content: center;
	align-items: center;
}

.screen {
	width: 100%;
	padding: 100px 420px;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.screen__title {
	color: #ff0f0f;
	font-size: 48px;
	width: 100%;
	-unity-text-align: upper-left;
}

.screen__content {
	width: 100%;
	color: rgb(215, 215, 215);
	font-size: 24px;
	white-space: normal;
	-unity-text-align: upper-left;
}

.fmod-logo {
	position: absolute;
	bottom: 0;
	right: 0;
	width: 96px;
	height: 24px;
	margin: 40px 30px;
	-unity-background-image-tint-color: rgb(245, 245, 245);
}
