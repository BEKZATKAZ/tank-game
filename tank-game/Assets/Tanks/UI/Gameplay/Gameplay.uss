:root {
    --text-color: rgb(243, 243, 243);
    --text-secondary-color: rgb(205, 205, 205);
    --font-regular: url("/Assets/Tanks/UI/Fonts/Tektur/Tektur-Regular.ttf");
    --font-heavy: url("/Assets/Tanks/UI/Fonts/Tektur/Tektur-ExtraBold.ttf");
    --font-black: url("/Assets/Tanks/UI/Fonts/Tektur/Tektur-Black.ttf");
}

* {
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: var(--text-color);
}

.start-counter {
    position: absolute;
    width: 100%;
    height: 100%;
    font-size: 160px;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.95);
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-center;
}

.eliminated {
    flex-grow: 1;
    justify-content: center;
}

.eliminated-title {
    font-size: 80px;
    color: red;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.95);
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-center;
}

.eliminated-subtitle {
    color: var(--text-secondary-color);
    font-size: 40px;
    text-shadow: 2px 2px 2px rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.item-description {
    margin: 150px 200px 0 0;
    position: absolute;
    top: 0;
    right: 0;
    min-width: 400px;
    max-width: 600px;
    background-color: rgba(0, 0, 0, 0.94);
    border-radius: 10px;
    transition: opacity 0.1s Ease 0s;
}

.item-description__header {
    padding: 10px;
    flex-direction: row;
}

.item-description__name {
    padding: 0 10px;
    font-size: 38px;
    letter-spacing: 2px;
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-left;
}

.item-description__icon {
    width: 64px;
    height: 64px;
    background-size: 70% 70%;
}

.item-description__body {
    padding: 10px 25px 25px 25px;
}

.item-description__description {
    color: var(--text-secondary-color);
    font-size: 24px;
    letter-spacing: 2px;
    white-space: normal;
}

.item-description__tier {
    padding-top: 25px;
    font-size: 24px;
    -unity-font-style: bold;
}

.player-stats {
    align-self: flex-start;
    padding: 40px 0;
    position: absolute;
}

.player-stats__tank {
    align-self: flex-start;
    width: 300px;
    height: 300px;
    background-color: white;
}

.player-stats__hp-overlay {
    width: 100%;
    background-color: red;
}

.timer {
    position: absolute;
    align-self: center;
}

.timer-counter {
    font-size: 64px;
    letter-spacing: 5px;
    -unity-font-definition: var(--font-black);
}

.game-stats {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    align-content: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.game-stats__container {
    background-color: rgba(0, 0, 0, 0.98);
    border-color: var(--text-color);
    border-width: 2px;
    border-radius: 20px;
}

.game-stats__header {
    font-size: 60px;
    padding: 20px 40px;
    margin-bottom: 20px;
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-center;
}

.game-stats__list-header {
    flex-direction: row;
}

.game-stats__list-header * {
    width: 100px;
    height: 40px;
    margin-bottom: 10px;
    -unity-background-image-tint-color: gray;
    -unity-background-scale-mode: scale-to-fit;
}

.game-stats__eliminations {
    margin-left: 540px;
}

.game-stats .unity-scroll-view {
    padding-bottom: 20px;
}

.game-stats__player {
    font-size: 30px;
    flex-direction: row;
    padding: 20px 40px;
}

.game-stats__player-eliminations,
.game-stats__player-assistance,
.game-stats__player-deaths,
.game-stats__player-victories {
    width: 100px;
    -unity-text-align: middle-center;
}

.game-stats__player-name {
    width: 500px;
}

.stats {
    position: absolute;
    left: 0;
    height: 100%;
    justify-content: center;
    padding-top: 70px;
    padding-left: 70px;
}

.stat {
    flex-direction: row;
    -unity-text-align: middle-left;
    margin-bottom: 8px;
    opacity: 0.5
}

.stat-icon {
    width: 64px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.stat-value {
    margin-left: 15px;
    font-size: 32px;
    opacity: 0.75;
    -unity-font-style: bold;
}

.stat-change {
    margin-left: 30px;
    font-size: 26px;
    opacity: 0.5;
    -unity-font-style: bold;
}

.transition-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--text-color);
    opacity: 0;
}
