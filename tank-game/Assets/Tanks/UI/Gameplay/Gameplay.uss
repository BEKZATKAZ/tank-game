.spectator-controls__name {
    align-self: center;
    max-width: 320px;
    font-size: 24px;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-shadow: 1px 1px 1px rgb(0, 0, 0);
}

.start-counter {
    position: absolute;
    width: 100%;
    height: 100%;
    font-size: 160px;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.eliminated {
    flex-grow: 1;
    justify-content: center;
}

.eliminated-title {
    font-size: 80px;
    color: red;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.eliminated-subtitle {
    color: var(--text-secondary-color);
    font-size: 40px;
    text-shadow: 2px 2px 2px rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.spectator-controls {
    position: absolute;
    bottom: 25px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.spectator-controls__button {
    margin: 0 12px;
    padding: 12px 24px;
    font-size: 24px;
    background-color: rgba(0, 0, 0, 0.75);
    border-color: var(--text-color);
    border-width: 2px;
    border-radius: 6px;
}

.spectator-controls__button:hover {
    background-color: rgba(70, 70, 70, 0.9);
}

.spectator-controls__button:disabled {
    opacity: 0.4;
}

.item-description {
    margin: 80px 80px 0 0;
    padding: 10px;
    position: absolute;
    top: 0;
    right: 0;
    min-width: 450px;
    max-width: 600px;
    transition: opacity 0.1s Ease 0s;
    filter: drop-shadow(0 0 20 black);
}

.item-description__header {
    padding: 10px 40px 10px 10px;
    flex-direction: row;
}

.item-description__name {
    padding: 0 10px;
    font-size: 34px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.item-description__icon {
    width: 46px;
    height: 46px;
    scale: 0.75 0.75;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.item-description__body {
    padding: 10px 25px 25px 25px;
}

.item-description__description {
    font-size: 22px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.item-description__tier {
    padding-top: 25px;
    font-size: 22px;
    -unity-font-style: bold;
}

.item-tagline {
    position: absolute;
    bottom: 0;
    margin-bottom: 100px;
    align-items: center;
    width: 100%;
    filter: drop-shadow(0 0 20 black);
}

.item-tagline__background {
    flex-grow: 0;
    flex-direction: row;
    padding: 32px;
    min-width: 600px;
    max-width: 1000px;
    transition: opacity 0.1s Ease 0s;
}

.item-tagline__icon {
    width: 68px;
    height: 68px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.item-tagline__text-content {
    flex-direction: column;
    font-size: 22px;
    margin: 0 60px 0 20px;
}

.item-tagline__name {
    margin-bottom: 2px;
    font-size: 24px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.item-tagline__text {
    color: var(--text-secondary-color);
    white-space: normal;
    -unity-text-align: middle-left;
}

.player-stats {
    flex-direction: row;
    align-self: flex-start;
    padding: 40px 0;
    position: absolute;
}

.player-stats__tank {
    align-self: flex-start;
    width: 300px;
    height: 300px;
    background-color: white;
}

.player-stats__hp-overlay {
    width: 100%;
    background-color: red;
}

.player-ammo {
    align-self: stretch;
    width: 20px;
    flex-shrink: 0;
    margin-left: 12px;
    padding: 2px;
    background-color: rgb(64, 64, 64);
    border-radius: 6px;
    overflow: hidden;
    visibility: hidden;
    left: -50px;
}

.player-ammo__slot {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    background-color: rgb(32, 32, 32);
    border-radius: 2px;
    overflow: hidden;
}

.player-ammo__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(128, 128, 128);
    border-radius: 2px;
}

.player-effects {
    align-self: flex-end;
    flex-direction: column-reverse;
    flex-shrink: 0;
    margin-left: 30px;
    left: -50px;
}

.player-effects__circle {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
}

.player-effects__icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.timer {
    position: absolute;
    align-self: center;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.95);
}

.timer-counter {
    font-size: 64px;
    letter-spacing: 5px;
    -unity-font-style: bold;
}

.timer-text {
    font-size: 20px;
    color: var(--text-secondary-color);
    -unity-font-style: bold;
}

.game-stats {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    align-content: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.game-stats__header {
    font-size: 48px;
    padding: 30px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.game-stats__list-header {
    flex-direction: row;
}

.game-stats__list-header * {
    width: 120px;
    height: 40px;
    margin-bottom: 10px;
    -unity-background-image-tint-color: gray;
    -unity-background-scale-mode: scale-to-fit;
}

.game-stats__eliminations {
    margin-left: 440px;
}

.game-stats .unity-scroll-view {
    padding-bottom: 20px;
}

.game-stats__player {
    font-size: 30px;
    flex-direction: row;
    padding: 20px 40px;
}

.game-stats__player-eliminations,
.game-stats__player-assistance,
.game-stats__player-deaths,
.game-stats__player-victories {
    width: 120px;
    -unity-text-align: middle-center;
}

.game-stats__player-name {
    width: 400px;
    -unity-text-align: middle-left;
}

.stats {
    position: absolute;
    left: 0;
    height: 100%;
    justify-content: center;
    padding-top: 70px;
    padding-left: 70px;
}

.stat {
    flex-direction: row;
    margin-bottom: 8px;
    opacity: 0.5;
    -unity-text-align: middle-left;
}

.stat-icon {
    width: 64px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.stat--temporary {
    opacity: 1;
}

.stat-timers {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-self: center;
    max-width: 300px;
    margin-left: 16px;
}

.stat-timer {
    margin-right: 8px;
    padding: 2px 8px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.75);
    font-size: 22px;
}

.stat-value {
    margin-left: 15px;
    font-size: 32px;
    opacity: 0.75;
}

.stat-change {
    margin-left: 30px;
    font-size: 26px;
    opacity: 0.5;
}

.killfeed {
    position: absolute;
    top: 40px;
    right: 40px;
    align-items: flex-end;
    overflow: visible;
}

.killfeed__entry {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 16px 32px;
    font-size: 24px;
}

.killfeed__name {
    max-width: 300px;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.killfeed__skull {
    width: 28px;
    height: 28px;
    margin-left: 12px;
    margin-right: 12px;
}

.item-list {
    position: absolute;
    right: 80px;
    width: 210px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    overflow: visible;
    opacity: 0.5;
}

.item-list__icon {
    width: 50px;
    height: 50px;
    margin: 10px;
    flex-shrink: 0;
    overflow: visible;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}

.item-list__count {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 24px;
    text-shadow: 1px 1px 2px black;
    -unity-font-style: bold;
}

.transition-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--text-color);
    opacity: 0;
}

.pickup-feed {
    position: absolute;
    bottom: 40px;
    right: 40px;
    max-width: 50%;
    align-items: flex-end;
    overflow: visible;
}

.pickup-feed__entry {
    max-width: 100%;
    margin-top: 8px;
    margin-bottom: 0;
}

.pickup-feed__text {
    flex-shrink: 1;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.pickup-feed__icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-left: 12px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
}
