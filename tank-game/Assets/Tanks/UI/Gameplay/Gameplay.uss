:root {
    --text-color: rgb(243, 243, 243);
    --text-secondary-color: rgb(205, 205, 205);
    --font-regular: url("project://database/Assets/Tanks/UI/Fonts/Tektur/Tektur-Regular.ttf?fileID=12800000&guid=5d22f6dbc7f666049806741c1e64720b&type=3#Tektur-Regular");
    --font-heavy: url("project://database/Assets/Tanks/UI/Fonts/Tektur/Tektur-ExtraBold.ttf?fileID=12800000&guid=f027ce80bdea4164a98c0cbc98e33c59&type=3#Tektur-ExtraBold");
    --font-black: url("project://database/Assets/Tanks/UI/Fonts/Tektur/Tektur-Black.ttf?fileID=12800000&guid=45f7b32b4f832744ebbabf86a666ecac&type=3#Tektur-Black");
}

* {
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: var(--text-color);
}

.start-counter {
    position: absolute;
    width: 100%;
    height: 100%;
    font-size: 160px;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.95);
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-center;
}

.eliminated {
    flex-grow: 1;
    justify-content: center;
}

.eliminated-title {
    font-size: 80px;
    color: red;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.95);
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-center;
}

.eliminated-subtitle {
    color: var(--text-secondary-color);
    font-size: 40px;
    text-shadow: 2px 2px 2px rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.item-description {
    margin: 80px 80px 0 0;
    padding: 10px;
    position: absolute;
    top: 0;
    right: 0;
    min-width: 450px;
    max-width: 600px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--text-color);
    transition: opacity 0.1s Ease 0s;
    filter: drop-shadow(0 0 20 black);
}

.item-description__header {
    padding: 10px 40px 10px 10px;
    flex-direction: row;
}

.item-description__name {
    padding: 0 10px;
    font-size: 34px;
    letter-spacing: 2px;
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-left;
}

.item-description__icon {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
    scale: 0.75 0.75;
}

.item-description__body {
    padding: 10px 25px 25px 25px;
}

.item-description__description {
    color: var(--text-secondary-color);
    font-size: 22px;
    letter-spacing: 2px;
    white-space: normal;
}

.item-description__tier {
    padding-top: 25px;
    font-size: 22px;
    -unity-font-style: bold;
}

.item-tagline {
    position: absolute;
    bottom: 0;
    margin-bottom: 90px;
    align-items: center;
    width: 100%;
    filter: drop-shadow(0 0 20 black);
}

.item-tagline__background {
    flex-grow: 0;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 20px;
    border-width: 3px;
    border-color: var(--text-color);
    padding: 22px;
    min-width: 600px;
    max-width: 1000px;
    transition: opacity 0.1s Ease 0s;
}

.item-tagline__icon {
    width: 68px;
    height: 68px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-tagline__text-content {
    flex-direction: column;
    font-size: 22px;
    margin: 0 60px 0 20px;
}

.item-tagline__name {
    -unity-font-definition: var(--font-black);
    margin-bottom: 8px;
    font-size: 24px;
}

.item-tagline__text {
    color: var(--text-secondary-color);
    white-space: normal;
}

.player-stats {
    align-self: flex-start;
    padding: 40px 0;
    position: absolute;
}

.player-stats__tank {
    align-self: flex-start;
    width: 300px;
    height: 300px;
    background-color: white;
}

.player-stats__hp-overlay {
    width: 100%;
    background-color: red;
}

.timer {
    position: absolute;
    align-self: center;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

.timer-counter {
    font-size: 64px;
    letter-spacing: 5px;
    -unity-font-definition: var(--font-black);
}

.timer-text {
    font-size: 20px;
    color: var(--text-secondary-color);
    -unity-font-style: bold;
}

.game-stats {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    align-content: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.game-stats__container {
    background-color: rgba(0, 0, 0, 0.98);
    border-color: var(--text-color);
    border-width: 2px;
    border-radius: 20px;
}

.game-stats__header {
    font-size: 60px;
    padding: 20px 40px;
    margin-bottom: 20px;
    -unity-font-definition: var(--font-black);
    -unity-text-align: middle-center;
}

.game-stats__list-header {
    flex-direction: row;
}

.game-stats__list-header * {
    width: 100px;
    height: 40px;
    margin-bottom: 10px;
    -unity-background-image-tint-color: gray;
    -unity-background-scale-mode: scale-to-fit;
}

.game-stats__eliminations {
    margin-left: 540px;
}

.game-stats .unity-scroll-view {
    padding-bottom: 20px;
}

.game-stats__player {
    font-size: 30px;
    flex-direction: row;
    padding: 20px 40px;
}

.game-stats__player-eliminations,
.game-stats__player-assistance,
.game-stats__player-deaths,
.game-stats__player-victories {
    width: 100px;
    -unity-text-align: middle-center;
}

.game-stats__player-name {
    width: 500px;
}

.stats {
    position: absolute;
    left: 0;
    height: 100%;
    justify-content: center;
    padding-top: 70px;
    padding-left: 70px;
}

.stat {
    flex-direction: row;
    -unity-text-align: middle-left;
    margin-bottom: 8px;
    opacity: 0.5;
}

.stat-icon {
    width: 64px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.stat-value {
    margin-left: 15px;
    font-size: 32px;
    opacity: 0.75;
    -unity-font-style: bold;
}

.stat-change {
    margin-left: 30px;
    font-size: 26px;
    opacity: 0.5;
    -unity-font-style: bold;
}

.killfeed {
    position: absolute;
    top: 40px;
    right: 40px;
    align-items: flex-end;
    overflow: visible;
}

.killfeed__entry {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 8px;
    font-size: 24px;
    -unity-font-definition: var(--font-heavy);
}

.killfeed__name {
    max-width: 300px;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.killfeed__skull {
    width: 28px;
    height: 28px;
    margin-left: 12px;
    margin-right: 12px;
    background-image: url("project://database/Assets/Plugins/Layer%20Lab/2D%20Icons-PictoIconPack01/PictoIcon_256/Icon_PictoIcon_Skull.Png?fileID=21300000&guid=13ab7e8c2a8f546c19a75f878cc8934b&type=3#Icon_PictoIcon_Skull");
    -unity-background-scale-mode: scale-to-fit;
}

.item-list {
    position: absolute;
    right: 80px;
    width: 210px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    overflow: visible;
    opacity: 0.5;
}

.item-list__icon {
    width: 50px;
    height: 50px;
    margin: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    overflow: visible;
}

.item-list__count {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 24px;
    -unity-font-definition: var(--font-heavy);
    text-shadow: 1px 1px 2px black;
}

.transition-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--text-color);
    opacity: 0;
}

.pickup-feed {
    position: absolute;
    bottom: 40px;
    right: 40px;
    max-width: 50%;
    align-items: flex-end;
    overflow: visible;
}

.pickup-feed__entry {
    border-width: 2px;
    max-width: 100%;
    margin-top: 8px;
    margin-bottom: 0;
}

.pickup-feed__text {
    flex-shrink: 1;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.pickup-feed__icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-left: 12px;
    -unity-background-scale-mode: scale-to-fit;
}