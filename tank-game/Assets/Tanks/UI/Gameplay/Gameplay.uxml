<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tanks/UI/Gameplay/Gameplay.uss?fileID=7433441132597879392&amp;guid=bb33b2d21da019b438ce1d0ab390cff8&amp;type=3#Gameplay"/>
    <ui:VisualElement name="ItemDescriptionContainer" class="item-description">
        <ui:VisualElement name="Header" class="item-description__header">
            <ui:VisualElement name="ItemIcon" class="item-description__icon" style="background-image: url(&quot;project://database/Assets/Tanks/Art/Items/Item_HP.png?fileID=2800000&amp;guid=2b35aef68fadf5243a92005fb41c4ed0&amp;type=3#Item_HP&quot;);"/>
            <ui:Label text="Health Up" enable-rich-text="false" emoji-fallback-support="false" name="ItemName" class="item-description__name"/>
        </ui:VisualElement>
        <ui:VisualElement name="Body" class="item-description__body">
            <ui:Label text="You restore &lt;#0f0&gt;40&lt;/color&gt; HP" name="ItemDescription" class="item-description__description"/>
            <ui:Label text="Uncommon" enable-rich-text="false" emoji-fallback-support="false" name="ItemTier" class="item-description__tier" style="color: rgb(0, 255, 51); -unity-text-align: middle-left;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="GO!" name="StartText" class="start-counter" style="display: none;"/>
    <ui:VisualElement name="EliminatedContainer" class="eliminated" style="display: flex;">
        <ui:Label name="EliminatedText" focusable="true" class="eliminated-title">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="Id(34970492928)"/>
            </Bindings>
        </ui:Label>
        <ui:Label name="EliminatedSubtitle" text="" enable-rich-text="false" class="eliminated-subtitle"/>
    </ui:VisualElement>
    <ui:VisualElement name="PlayerStats" class="player-stats">
        <ui:VisualElement name="PlayerTank" class="player-stats__tank" style="-unity-material: url(&quot;project://database/Assets/Tanks/Shaders/TankHP.shadergraph?fileID=-876546973899608171&amp;guid=30d36fd8c31436746931c48cd0dac5af&amp;type=3#TankHP&quot;);"/>
    </ui:VisualElement>
</ui:UXML>
