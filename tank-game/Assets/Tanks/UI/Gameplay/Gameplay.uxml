<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ItemDescriptionContainer" style="flex-grow: 1; position: absolute; right: 0; margin-top: 150px; margin-right: 200px; margin-bottom: 0; margin-left: 0; background-color: rgba(0, 0, 0, 0.949); top: 0; min-width: 400px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; max-width: 600px; transition-property: opacity; transition-duration: 0.1s; opacity: 1;">
        <ui:VisualElement name="Header" style="flex-grow: 1; flex-direction: row; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
            <ui:VisualElement name="ItemIcon" style="background-image: url(&quot;project://database/Assets/Tanks/Art/Items.png?fileID=263260402&amp;guid=1c10ab560e7afed43991be2cabaf3733&amp;type=3#Items_0&quot;); width: 64px; height: 64px; background-size: 70% 70%;"/>
            <ui:Label text="Health Up" enable-rich-text="false" emoji-fallback-support="false" name="ItemName" style="color: rgb(242, 242, 242); -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Black&quot;); font-size: 38px; -unity-font-style: bold; word-spacing: 0; letter-spacing: 1px; -unity-text-align: middle-left; scale: 1 0.98; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-bottom: 0; padding-right: 10px; padding-left: 10px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 25px; padding-bottom: 25px; padding-left: 25px;">
            <ui:Label text="You restore &lt;#0f0&gt;40&lt;/color&gt; HP" name="ItemDescription" style="color: rgb(217, 217, 217); -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Light&quot;); font-size: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-right: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; letter-spacing: 2px; white-space: normal;"/>
            <ui:Label text="Uncommon" enable-rich-text="false" emoji-fallback-support="false" name="ItemTier" style="color: rgb(0, 255, 51); -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Medium&quot;); font-size: 22px; -unity-font-style: bold; word-spacing: 0; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 25px; padding-bottom: 0; padding-right: 0; padding-left: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="GO!" enable-rich-text="false" emoji-fallback-support="false" name="StartText" display-tooltip-when-elided="false" triple-click-selects-line="false" double-click-selects-word="false" style="position: absolute; width: 100%; height: 100%; color: rgba(255, 255, 255, 0.949); font-size: 160px; -unity-font-style: normal; -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Black&quot;); -unity-text-align: middle-center; text-shadow: 0 0 2px rgb(0, 0, 0); display: none;"/>
    <ui:VisualElement name="EliminatedContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; justify-content: center; display: none;">
        <ui:Label text="ELIMINATED" name="EliminatedText" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="-unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Black&quot;); color: rgb(255, 0, 0); -unity-text-align: lower-center; font-size: 120px; -unity-font-style: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-shadow: 4px 4px 2px rgb(0, 0, 0);"/>
        <ui:Label text="By BEKZATKAZ" name="EliminatedSubtitle" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="color: rgb(204, 204, 204); font-size: 40px; -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Light&quot;); -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-shadow: 2px 2px 2px rgb(0, 0, 0);"/>
    </ui:VisualElement>
</ui:UXML>
