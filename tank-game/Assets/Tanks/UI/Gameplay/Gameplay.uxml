<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="GO!" enable-rich-text="false" emoji-fallback-support="false" name="StartText" display-tooltip-when-elided="false" triple-click-selects-line="false" double-click-selects-word="false" style="position: absolute; width: 100%; height: 100%; color: rgba(255, 255, 255, 0.949); font-size: 160px; -unity-font-style: normal; -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Black&quot;); -unity-text-align: middle-center; text-shadow: 0 0 2px rgb(0, 0, 0); display: none;"/>
    <ui:VisualElement name="EliminatedContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; justify-content: center;">
        <ui:Label text="ELIMINATED" name="EliminatedText" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="-unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Black&quot;); color: rgb(255, 0, 0); -unity-text-align: lower-center; font-size: 120px; -unity-font-style: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-shadow: 4px 4px 2px rgb(0, 0, 0);"/>
        <ui:Label text="By BEKZATKAZ" name="EliminatedBy" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="color: rgb(204, 204, 204); font-size: 40px; -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-Light&quot;); -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-shadow: 2px 2px 2px rgb(0, 0, 0);"/>
    </ui:VisualElement>
</ui:UXML>
