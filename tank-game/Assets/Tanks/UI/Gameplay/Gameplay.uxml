<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Tanks/UI/MainStyle.uss?fileID=7433441132597879392&amp;guid=77478ecc0cc878b408414e9bc657328f&amp;type=3#MainStyle"/>
    <Style src="project://database/Assets/Tanks/UI/PlayerNames.uss?fileID=7433441132597879392&amp;guid=d709c0e2e2f94a7b81703dd81f41caf6&amp;type=3#PlayerNames"/>
    <Style src="project://database/Assets/Tanks/UI/Gameplay/Gameplay.uss?fileID=7433441132597879392&amp;guid=bb33b2d21da019b438ce1d0ab390cff8&amp;type=3#Gameplay"/>
    <ui:VisualElement name="PlayerNames" picking-mode="Ignore" class="player-names"/>
    <ui:Label text="GO!" name="StartText" class="start-counter" style="display: none;"/>
    <ui:VisualElement name="EliminatedContainer" class="eliminated" style="display: none;">
        <ui:Label name="EliminatedText" focusable="true" class="eliminated-title">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="Id(34970492928)"/>
            </Bindings>
        </ui:Label>
        <ui:Label name="EliminatedSubtitle" text="" enable-rich-text="false" class="eliminated-subtitle"/>
    </ui:VisualElement>
    <ui:VisualElement name="ItemTagline" class="item-tagline">
        <ui:VisualElement name="Background" class="item-tagline__background" style="border-left-color: rgb(0, 255, 255); border-right-color: rgb(0, 255, 255); border-top-color: rgb(0, 255, 255); border-bottom-color: rgb(0, 255, 255);">
            <ui:VisualElement name="Fill" class="bg-fill" style="-unity-material: url(&quot;project://database/Assets/Tanks/Shaders/ElementSprite.shadergraph?fileID=-876546973899608171&amp;guid=625da925d29692e4ca44f436c97f8cdc&amp;type=3#ElementSprite&quot;) prop(&quot;_FillColor&quot; rgba(0, 0, 0, 0.667)) prop(&quot;_BorderColor&quot; rgb(0, 247, 247));"/>
            <ui:VisualElement name="Icon" class="item-tagline__icon" style="background-image: url(&quot;project://database/Assets/Tanks/Art/Items/Item_Teleport.png?fileID=21300000&amp;guid=49ec673f03073f646b1e7b6bb887f057&amp;type=3#Item_Teleport&quot;);"/>
            <ui:VisualElement name="TextContent" class="item-tagline__text-content">
                <ui:Label text="You picked up &lt;color=#0ff&gt;Random Teleport&lt;/color&gt;" name="Header" class="item-tagline__name"/>
                <ui:Label text="Flee with a lil&apos; twist." name="Tagline" class="item-tagline__text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PlayerHealth" class="player-stats">
        <ui:VisualElement name="PlayerTank" class="player-stats__tank" style="-unity-material: url(&quot;project://database/Assets/Tanks/Shaders/TankHP.shadergraph?fileID=-876546973899608171&amp;guid=30d36fd8c31436746931c48cd0dac5af&amp;type=3#TankHP&quot;);"/>
        <ui:VisualElement name="PlayerAmmo" picking-mode="Ignore" class="player-ammo"/>
        <ui:VisualElement name="PlayerEffects" picking-mode="Ignore" class="player-effects"/>
    </ui:VisualElement>
    <ui:VisualElement name="PlayerStats" class="stats">
        <Tanks.UI.Gameplay.PlayerStats.PlayerStatElement icon="project://database/Assets/Tanks/Art/Stats/Stat_Speed.png?fileID=21300000&amp;guid=fde38c6e8dcbbde4e816c132830850fb&amp;type=3#Stat_Speed" name="Speed" type="Speed"/>
        <Tanks.UI.Gameplay.PlayerStats.PlayerStatElement icon="project://database/Assets/Tanks/Art/Stats/Stat_Damage.png?fileID=21300000&amp;guid=eec19d99c7c71174d878e2a2f6a5f780&amp;type=3#Stat_Damage" name="Damage" type="Damage"/>
        <Tanks.UI.Gameplay.PlayerStats.PlayerStatElement icon="project://database/Assets/Tanks/Art/Stats/Stat_Defense.png?fileID=21300000&amp;guid=9fbdfbfa6f6cef440a231d9caa5d75ec&amp;type=3#Stat_Defense" name="Defense" type="Defense"/>
        <Tanks.UI.Gameplay.PlayerStats.PlayerStatElement icon="project://database/Assets/Tanks/Art/Stats/Stat_RateOfFire.png?fileID=21300000&amp;guid=90a6e73b2aa18f943bb30c72fecf6a46&amp;type=3#Stat_RateOfFire" name="RateOfFire" type="RateOfFire"/>
        <Tanks.UI.Gameplay.PlayerStats.PlayerStatElement icon="project://database/Assets/Tanks/Art/Stats/Stat_Resistance.png?fileID=21300000&amp;guid=c808a429597b0f94d9deec1a6f801d8b&amp;type=3#Stat_Resistance" name="Resistance" type="Resistance"/>
    </ui:VisualElement>
    <ui:VisualElement name="Killfeed" picking-mode="Ignore" class="killfeed"/>
    <ui:VisualElement name="PickupFeed" picking-mode="Ignore" class="pickup-feed"/>
    <ui:VisualElement name="Timer" class="timer" style="flex-grow: 1;">
        <ui:Label text="45" name="TimerCounter" class="timer-counter"/>
        <ui:Label text="BEFORE ZONE STARTS" name="TimerText" class="timer-text"/>
    </ui:VisualElement>
    <Tanks.UI.Gameplay.ItemList.ItemListElement name="ItemList"/>
    <ui:VisualElement name="ItemDescriptionContainer" class="bg-outline item-description">
        <ui:VisualElement name="Fill" class="bg-fill" style="-unity-material: url(&quot;project://database/Assets/Tanks/Shaders/ElementSprite.shadergraph?fileID=-876546973899608171&amp;guid=625da925d29692e4ca44f436c97f8cdc&amp;type=3#ElementSprite&quot;) prop(&quot;_BorderColor&quot; rgb(0, 255, 255)) prop(&quot;_FillColor&quot; rgba(0, 0, 0, 0.667));"/>
        <ui:VisualElement name="Header" class="item-description__header">
            <ui:VisualElement name="ItemIcon" class="item-description__icon" style="background-image: url(&quot;project://database/Assets/Tanks/Art/Items/Item_HP.png?fileID=21300000&amp;guid=2b35aef68fadf5243a92005fb41c4ed0&amp;type=3#Item_HP&quot;);"/>
            <ui:Label text="Large Health Up" enable-rich-text="false" emoji-fallback-support="false" name="ItemName" class="item-description__name"/>
        </ui:VisualElement>
        <ui:VisualElement name="Body" class="item-description__body">
            <ui:Label text="Every &lt;color=#0f0&gt;9&lt;/color&gt; seconds, your stats increase one by one. Only one stat can be affected at a time, previous stats get back to normal. Once it passes the last stat, the cycle repeats from the first stat." name="ItemDescription" class="item-description__description" style="-unity-font-definition: url(&quot;project://database/Assets/Tanks/UI/Fonts/NanoPlus%20Bitmap.asset?fileID=11400000&amp;guid=7941d67f1ed9bb145b638373d0de683f&amp;type=2#NanoPlus Bitmap&quot;);"/>
            <ui:Label text="Rare" enable-rich-text="false" emoji-fallback-support="false" name="ItemTier" class="item-description__tier" style="color: rgb(0, 255, 255); -unity-text-align: middle-left;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="GameStats" class="game-stats" style="display: none;">
        <ui:VisualElement name="GameStatsContainer">
            <ui:VisualElement name="Fill" class="bg-fill"/>
            <ui:Label name="GameStatsHeader" text="Statistics - Round 1" class="game-stats__header"/>
            <ui:VisualElement name="GameStatsListHeader" class="game-stats__list-header" style="flex-grow: 1;">
                <ui:Label name="Eliminations" class="game-stats__eliminations">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="Id(22050365577322496)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label name="Assistance">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="Id(22050365615071232)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label name="Deaths">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="Id(22050365615071233)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label name="Victories">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="Id(22050365615071234)"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:ScrollView name="PlayerList">
                <Tanks.UI.Gameplay.GameStats.PlayerElement/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="SpectatorControls" picking-mode="Ignore" class="spectator-controls" style="display: none;">
        <Tanks.UI.Elements.CustomButton name="PreviousSpectatorTarget" focusable="false" class="spectator-controls__button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="gameplay.spectator.previous"/>
            </Bindings>
        </Tanks.UI.Elements.CustomButton>
        <ui:Label name="SpectatorName" enable-rich-text="false" picking-mode="Ignore" class="spectator-controls__name"/>
        <Tanks.UI.Elements.CustomButton name="NextSpectatorTarget" focusable="false" class="spectator-controls__button">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:be3c65f295ea4a545a8406a0bc7b68e6" entry="gameplay.spectator.next"/>
            </Bindings>
        </Tanks.UI.Elements.CustomButton>
    </ui:VisualElement>
    <ui:VisualElement name="TransitionOverlay" picking-mode="Ignore" class="transition-overlay"/>
</ui:UXML>
