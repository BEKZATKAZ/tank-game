#PauseOverlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
}

#PauseContent {
    flex-grow: 1;
    width: 100%;
}

#PauseContent #Menu {
    flex-grow: 1;
    min-height: 0;
}

#PauseContent .settings-section {
    background-color: transparent;
    min-height: 0;
}

#PauseContent .settings {
    max-height: 90%;
}

#PauseContent .settings .unity-scroll-view {
    flex-shrink: 1;
    min-height: 0;
}

#PauseContent .setting,
#PauseContent .settings-bottom {
    flex-shrink: 0;
}
