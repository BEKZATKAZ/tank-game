:root {
    background-color: black;
}

.title-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-content: center;
    justify-content: center;
    -unity-text-align: middle-center;
}

.game-title {
    letter-spacing: -3px;
    font-size: 74px;
    -unity-font-style: bold;
}

.loading-progress {
    align-self: center;
}

.loading-progress * {
    border-width: 0;
    width: 298px;
}

.loading-progress .unity-progress-bar__background {
    background-color: rgb(32, 32, 32);
}

.loading-progress .unity-progress-bar__progress {
    background-color: var(--text-color);
}

.loading-bottom {
    width: 100%;
    height: 100%;
    bottom: 0;
    align-self: center;
    align-content: center;
    justify-content: center;
    margin-bottom: 150px;
    flex-direction: row;
    align-items: flex-end;
}

.tip-text {
    width: 750px;
    font-size: 24px;
    color: var(--text-secondary-color);
    margin-bottom: 20px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.menu-load-error {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 45%;
    padding: 24px;
    background-color: rgb(24, 24, 24);
}
