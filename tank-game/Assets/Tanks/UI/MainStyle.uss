:root {
    --text-color: rgb(243, 243, 243);
    --text-secondary-color: rgb(205, 205, 205);
    --bg: rgb(54, 54, 54);
    --bg-dark: rgb(24, 24, 24);
    --bg-image: url("project://database/Assets/Tanks/Art/UI/Button.png?fileID=21300000&guid=32bc2d6251e06204e8a534f73230d7f2&type=3#Button");
}

* {
    margin: 0;
    padding: 0;
    color: var(--text-color);
    border-color: var(--border-color);
    font-size: 24px;
    letter-spacing: 5px;
    word-spacing: 10px;
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: var(--bg);
    -unity-font-definition: url("project://database/Assets/Tanks/UI/Fonts/NanoPlus%20Bitmap.asset?fileID=11400000&guid=7941d67f1ed9bb145b638373d0de683f&type=2#NanoPlus Bitmap");
}

.bg-fill {
    position: absolute;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    top: 0;
    left: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bg-image);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-material: url("project://database/Assets/Tanks/Shaders/ElementSprite.shadergraph?fileID=-876546973899608171&guid=625da925d29692e4ca44f436c97f8cdc&type=3#ElementSprite");
}

.unity-base-field__input {
    background-color: transparent;
}

.unity-text-field__input {
    --unity-cursor-color: var(--text-color);
}

.unity-button,
.unity-base-field {
    color: rgba(243, 243, 243, 0.6);
    font-size: 32px;
    border-width: 0;
    padding: 20px 40px;
    background-image: var(--bg-image);
    background-color: rgba(0, 0, 0, 0);
    filter: drop-shadow(3 6 0 rgba(0, 0, 0, 0.5));
}

.unity-base-field {
    padding: 0;
}

.unity-button.menu-highlighted:enabled {
    -unity-background-image-tint-color: var(--text-color);
    color: black;
}

.unity-scroller {
    background-image: none;
    background-color: var(--bg-dark);
    border-width: 0;
    padding: 0;
}

.unity-scroller--vertical {
    width: 12px;
    min-width: 12px;
    margin-left: 8px;
}

.unity-scroller--horizontal {
    height: 12px;
    min-height: 12px;
    margin-top: 8px;
}

.unity-scroller .unity-scroller__low-button,
.unity-scroller .unity-scroller__high-button {
    display: none;
}

.unity-scroller .unity-base-slider,
.unity-scroller .unity-base-slider__input {
    background-image: none;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    filter: none;
}

.unity-scroller .unity-base-slider__tracker {
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-image: none;
    background-color: var(--bg);
    border-width: 0;
    border-radius: 2px;
}

.unity-scroller:hover .unity-base-slider__dragger {
    background-color: var(--text-secondary-color);
}

.unity-scroller .unity-base-slider__dragger:active {
    background-color: var(--text-color);
}

.unity-scroller:disabled .unity-base-slider__dragger {
    opacity: 0.3;
}


