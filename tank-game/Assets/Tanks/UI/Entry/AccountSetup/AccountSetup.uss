* {
	color: rgb(245, 245, 245);
}

#EntryRoot {
	flex-grow: 1;
	justify-content: center;
	align-items: center;
}

#AccountSetup {
	padding: 30px;
	border-width: 4px;
	border-radius: 20px;
}

#AccountSetupHeader {
	font-size: 42px;
	margin-bottom: 15px;
	-unity-text-align: middle-center;
}

#Consent {
	flex-direction: row-reverse;
	font-size: 24px;
	margin-bottom: 20px;
}

#Consent .unity-toggle__input {
	flex: 0 0 auto;
	margin-right: 15px;
}

#Consent .unity-label {
	flex-grow: 1;
}

.unity-text-field {
	font-size: 28px;
	margin-bottom: 50px;
	border-width: 2px;
}

.unity-text-field .unity-base-field__input {
	padding: 10px 20px;
}

.unity-text-field .unity-text-element {
	color: black;
}

.unity-button {
	border-width: 2px;
}
