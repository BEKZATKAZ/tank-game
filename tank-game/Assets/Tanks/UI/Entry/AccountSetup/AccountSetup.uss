#EntryRoot {
	flex-grow: 1;
	justify-content: center;
	align-items: center;
}

#AccountSetup {
	padding: 30px;
	border-width: 4px;
	border-radius: 20px;
}

#AccountSetupHeader {
	font-size: 42px;
	margin-bottom: 15px;
	-unity-text-align: middle-center;
}

.unity-text-field {
	font-size: 28px;
	margin-bottom: 25px;
	border-width: 2px;
}

.unity-text-field .unity-base-field__input {
	padding: 10px 20px;
	--unity-cursor-color: black;
}

#PrivacyPolicy {
    -unity-background-image-tint-color: var(--bg-dark);
    background-image: var(--bg-image);
    width: 90%;
    max-width: 1050px;
    max-height: 90%;
    padding: 24px;
    border-width: 4px;
    border-radius: 20px;
    flex-shrink: 1;
}

#PolicyHeader {
    font-size: 36px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

#PolicyScroll {
    height: 420px;
    flex-shrink: 1;
    margin-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.75);
    padding: 20px;
}

#PolicyText, #PolicyError, #PolicyLoading, #PolicyConsent {
    white-space: normal;
    font-size: 20px;
    -unity-text-align: middle-left;
}

#PolicyConsent {
    margin-bottom: 16px;
    flex-direction: row-reverse;
    justify-content: flex-end;
    -unity-background-image-tint-color: transparent;
}

#PolicyConsent .unity-toggle__input {
    flex: 0 0 auto;
    margin-right: 15px;
}

#PolicyActions {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
}

#PolicyActions .unity-button {
    min-width: 140px;
    margin-left: 12px;
    padding: 12px 20px;
    -unity-text-align: middle-center;
    font-size: 24px;
}
