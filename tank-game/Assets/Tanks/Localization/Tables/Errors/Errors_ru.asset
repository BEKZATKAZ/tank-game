  m_Name: Errors_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 034deb129b9dd5842973b131521ca8de, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 8684789760
    m_Localized: "\u0427\u0442\u043E-\u0442\u043E \u043F\u043E\u0448\u043B\u043E \u043D\u0435 \u0442\u0430\u043A. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 632541372416
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E. \u041E\u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442\u043E \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1071924076544
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 5444695711744
    m_Localized: "\u041E\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 214359618314240
    m_Localized: "\u041E\u0428\u0418\u0411\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 675254177849344
    m_Localized: "\u041E \u043F\u043E\u0442\u0438\u0448\u0435, \u043F\u043E\u0442\u0438\u0448\u0435! \u0412\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0437\u0430\u043F\u0440\u043E\u0441\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 1049871174295552
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043D\u0438\u043A\u043D\u0435\u0439\u043C. \u0414\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u043C\u0438\u043D\u0438\u043C\u0443\u043C 3 \u0441\u0438\u043C\u0432\u043E\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1051715732725760
    m_Localized: "\u041D\u0438\u043A\u043D\u0435\u0439\u043C \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 13262707732471808
    m_Localized: "\u0423\u043F\u0441! \u0423 \u043D\u0430\u0441 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0443\u0431\u0440\u0430\u0442\u044C \u0432\u0430\u0441 \u0441 \u043B\u043E\u0431\u0431\u0438. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13688554381598720
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u0435\u0440\u0432\u0435\u0440. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 13688838436642816
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F \u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u0432\u044B\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 14073502426947584
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043B\u043E\u0431\u0431\u0438. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 14704694973128704
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 14705904262275072
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F \u0437\u0430\u043F\u0440\u043E\u0441\u0430 \u0432\u044B\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 14708398786830336
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F \u043A \u043B\u043E\u0431\u0431\u0438. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 14708559386730496
    m_Localized: "\u0412\u0435\u0440\u0441\u0438\u0438 \u043B\u043E\u0431\u0431\u0438 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166720
    m_Localized: "\u041B\u043E\u0431\u0431\u0438 \u0431\u044B\u043B\u043E \u0440\u0430\u0441\u043F\u0443\u0449\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166721
    m_Localized: Чат лобби недоступен. Попробуйте отправить сообщение снова.
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166722
    m_Localized: Не удалось отправить сообщение. Попробуйте снова.
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166723
    m_Localized: Введите сообщение длиной от 1 до 500 символов.
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000000
    m_Localized: "\u042d\u0442\u043e\u0442 \u043e\u0431\u043b\u0438\u043a \u0443\u0436\u0435 \u043e\u0442\u043a\u0440\u044b\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000001
    m_Localized: "\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u0432\u0430\u043b\u044e\u0442\u044b."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000002
    m_Localized: "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u044d\u0442\u043e\u0442 \u043e\u0431\u043b\u0438\u043a."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000003
    m_Localized: "\u042d\u0442\u0430 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0435\u0449\u0451 \u043d\u0435 \u0433\u043e\u0442\u043e\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000004
    m_Localized: "\u042d\u0442\u043e\u0442 \u0442\u043e\u0432\u0430\u0440 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000005
    m_Localized: "\u042d\u0442\u043e\u0442 \u043e\u0431\u043b\u0438\u043a \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000006
    m_Localized: "\u042d\u0442\u043e\u0442 \u043e\u0431\u043b\u0438\u043a \u043d\u0435\u043b\u044c\u0437\u044f \u043a\u0443\u043f\u0438\u0442\u044c."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000007
    m_Localized: "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u0433\u0440\u043e\u043a\u0430. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000008
    m_Localized: "\u0412\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u043a\u043a\u0430\u0443\u043d\u0442 \u0437\u0430\u043d\u043e\u0432\u043e, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u043c."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000009
    m_Localized: "\u0426\u0435\u043d\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043d\u043e\u0432\u0443\u044e \u0446\u0435\u043d\u0443 \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u043a\u0443\u043f\u043a\u043e\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 45000000000000000
    m_Localized: "\u0420\u201d\u0420\u00b0\u0420\u0405\u0420\u0405\u0421\u2039\u0420\u00b5 \u0420\u0451\u0420\u0456\u0421\u0402\u0420\u0455\u0420\u0454\u0420\u00b0 \u0420\u0451\u0420\u00b7\u0420\u0458\u0420\u00b5\u0420\u0405\u0420\u0451\u0420\u00bb\u0420\u0451\u0421\u0403\u0421\u040a. \u0420\u045f\u0420\u0455\u0420\u0406\u0421\u201a\u0420\u0455\u0421\u0402\u0420\u0451\u0421\u201a\u0420\u00b5 \u0420\u0457\u0420\u0455\u0420\u0457\u0421\u2039\u0421\u201a\u0420\u0454\u0421\u0453."
    m_Metadata:
      m_Items: []
  - m_Id: 45000000000000001
    m_Localized: "\u0420\u040e\u0420\u00bb\u0420\u0451\u0421\u20ac\u0420\u0454\u0420\u0455\u0420\u0458 \u0420\u0458\u0420\u0405\u0420\u0455\u0420\u0456\u0420\u0455 \u0420\u00b7\u0420\u00b0\u0420\u0457\u0421\u0402\u0420\u0455\u0421\u0403\u0420\u0455\u0420\u0406. \u0420\u045f\u0420\u0455\u0420\u0406\u0421\u201a\u0420\u0455\u0421\u0402\u0420\u0451\u0421\u201a\u0420\u00b5 \u0420\u0457\u0420\u0455\u0420\u0457\u0421\u2039\u0421\u201a\u0420\u0454\u0421\u0453 \u0421\u2021\u0421\u0453\u0421\u201a\u0421\u040a \u0420\u0457\u0420\u0455\u0420\u00b7\u0420\u00b6\u0420\u00b5."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
