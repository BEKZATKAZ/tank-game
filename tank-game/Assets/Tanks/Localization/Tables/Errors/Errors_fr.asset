  m_TableData:
  - m_Id: 46000000000000001
    m_Localized: "Connexion impossible. V\u00e9rifiez que le serveur fonctionne et r\u00e9essayez."
    m_Metadata:
      m_Items: []
  - m_Id: 46000000000000002
    m_Localized: "Ce compte est d\u00e9j\u00e0 connect\u00e9. Utilisez un compte diff\u00e9rent pour chaque client."
    m_Metadata:
      m_Items: []
  - m_Id: 46000000000000003
    m_Localized: "La partie a d\u00e9j\u00e0 commenc\u00e9. Rejoignez une autre session."
    m_Metadata:
      m_Items: []
  - m_Id: 8684789760
    m_Localized: "Une erreur s'est produite. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 214359618314240
    m_Localized: ERREUR
    m_Metadata:
      m_Items: []
  - m_Id: 5444695711744
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 1051715732725760
    m_Localized: "Nom d'utilisateur d\xE9j\xE0 pris."
    m_Metadata:
      m_Items: []
  - m_Id: 1049871174295552
    m_Localized: "Nom d'utilisateur trop court. Veuillez choisir un nom d'utilisateur d'au moins 3 caract\xE8res."
    m_Metadata:
      m_Items: []
  - m_Id: 675254177849344
    m_Localized: Oh, du calme, du calme ! Vous faites trop de demandes !
    m_Metadata:
      m_Items: []
  - m_Id: 1071924076544
    m_Localized: Le lobby n'est plus disponible.
    m_Metadata:
      m_Items: []
  - m_Id: 632541372416
    m_Localized: "Lobby introuvable. Il est peut-\xEAtre ferm\xE9 ou n'existe plus."
    m_Metadata:
      m_Items: []
  - m_Id: 14073502426947584
    m_Localized: "Impossible de cr\xE9er le lobby. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 14708398786830336
    m_Localized: "Impossible de rejoindre le lobby. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 13262707732471808
    m_Localized: "Oups ! Nous n'avons pas pu vous retirer du lobby. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 13688554381598720
    m_Localized: "Impossible de d\xE9marrer le serveur. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 13688838436642816
    m_Localized: "D\xE9lai d'attente du serveur d\xE9pass\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 14704694973128704
    m_Localized: Le lobby est plein.
    m_Metadata:
      m_Items: []
  - m_Id: 14705904262275072
    m_Localized: "D\xE9lai d'attente d\xE9pass\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 14708559386730496
    m_Localized: Version du lobby incompatible.
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166720
    m_Localized: "Le lobby a \xE9t\xE9 dissous."
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166721
    m_Localized: "Le chat du lobby est indisponible. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166722
    m_Localized: "Envoi du message impossible. Veuillez r\xE9essayer."
    m_Metadata:
      m_Items: []
  - m_Id: 14710554747166723
    m_Localized: "Saisissez un message contenant entre 1 et 500 caract\xE8res."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000000
    m_Localized: "Cette apparence est d\u00e9j\u00e0 d\u00e9bloqu\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000001
    m_Localized: "Vous ne disposez pas de suffisamment de monnaie."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000002
    m_Localized: "D\u00e9bloquez cette apparence avant de l\u2019\u00e9quiper."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000003
    m_Localized: "Cette r\u00e9compense n\u2019est pas encore disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000004
    m_Localized: "Cet article est indisponible. Actualisez la boutique."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000005
    m_Localized: "Cette apparence n\u2019est plus disponible."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000006
    m_Localized: "Cette apparence ne peut pas \u00eatre achet\u00e9e."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000007
    m_Localized: "Impossible de mettre \u00e0 jour les donn\u00e9es du joueur. R\u00e9essayez."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000008
    m_Localized: "Reconnectez-vous pour utiliser la boutique."
    m_Metadata:
      m_Items: []
  - m_Id: 44000000000000009
    m_Localized: "Le prix a chang\u00e9. V\u00e9rifiez le nouveau prix avant d\u2019acheter."
    m_Metadata:
      m_Items: []
  - m_Id: 45000000000000000
    m_Localized: "Les donn\u00e9es du joueur ont chang\u00e9. R\u00e9essayez."
    m_Metadata:
      m_Items: []
  - m_Id: 45000000000000001
    m_Localized: "Trop de requ\u00eates. R\u00e9essayez dans un instant."
    m_Metadata:
      m_Items: []
  references:
    version: 2
