  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Loading_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 8a7fe4fa637c3cb4d9a09d65255608c7, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 9594953728
    m_Localized: 'Les projectiles ricochent sur les murs, ne tirez pas sans raison

      sauf si vous voyez un ennemi.'
    m_Metadata:
      m_Items: []
  - m_Id: 2198761594880
    m_Localized: "La carte est g\xE9n\xE9r\xE9e al\xE9atoirement, gardez cela \xE0 l'esprit."
    m_Metadata:
      m_Items: []
  - m_Id: 2424410955776
    m_Localized: "Surveillez le minuteur\_: il indique le d\xE9but de la zone de danger et sa dur\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 3757503373312
    m_Localized: "Si vous vous autod\xE9truisez, vous obtiendrez -1 point."
    m_Metadata:
      m_Items: []
  - m_Id: 1127561519104
    m_Localized: Divers objets apparaissent un peu partout sur la carte, mais lisez leur description avant de les ramasser.
    m_Metadata:
      m_Items: []
  - m_Id: 4690362720256
    m_Localized: "Les objets instables sont parmi les plus rares, mais aussi les plus complexes. Utilisez-les \xE0 vos risques et p\xE9rils."
    m_Metadata:
      m_Items: []
  - m_Id: 6446383587328
    m_Localized: "L'arme standard dispose de munitions illimit\xE9es, mais elle doit \xEAtre recharg\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 7583602008064
    m_Localized: "Vous trouverez \xE9galement des armes parmi les objets. Attention au recul\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 8203172012032
    m_Localized: "Chaque \xE9l\xE9ment appartient \xE0 un niveau. Ils se distinguent par leur son et leur couleur caract\xE9ristiques."
    m_Metadata:
      m_Items: []
  - m_Id: 12075842715213824
    m_Localized: "En avan\xE7ant et en tirant vers l'arri\xE8re, vous pouvez vous propulser vers l'avant beaucoup plus vite qu'en conduisant."
    m_Metadata:
      m_Items: []
  - m_Id: 10569631883264
    m_Localized: Ne gaspillez pas de carburant. Il n'y a pas de carburant dans ce jeu.
    m_Metadata:
      m_Items: []
  - m_Id: 7943608060043264
    m_Localized: "Les caisses peuvent contenir des objets instables, mais il y a une faible probabilit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 12074306069028864
    m_Localized: Certains objets fonctionneront bien avec votre build, d'autres non... Logique.
    m_Metadata:
      m_Items: []
  - m_Id: 12074306110971904
    m_Localized: "Certains objets peuvent vous \xE9liminer instantan\xE9ment si vous les ramassez plus d'une fois. Lisez leur description."
    m_Metadata:
      m_Items: []
  - m_Id: 12074306110971905
    m_Localized: "Surveillez vos stats \xE0 gauche, elles contiennent des informations utiles."
    m_Metadata:
      m_Items: []
  - m_Id: 12075842715213825
    m_Localized: "Vous n'aimez pas les d\xE9g\xE2ts que vous vous infligez, ou vous en voulez davantage\_? Vous pouvez les ajuster dans les param\xE8tres du lobby."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
