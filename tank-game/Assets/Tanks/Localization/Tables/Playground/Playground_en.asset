  - m_Id: 5560085209088
    m_Localized: Aim at the crates and clear your way.
    m_Metadata:
      m_Items: []
  - m_Id: 5560089403392
    m_Localized: You have found a secret!
    m_Metadata:
      m_Items: []
  - m_Id: 5560089403393
