  - m_Id: 2067794452480
    m_Localized: "\u0412\u044B \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0430\u0431\u0441\u0443\u0440\u0434\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0443\u0440\u043E\u043D\u0430, \u043D\u043E \u043E\u0434\u043D\u043E \u043B\u0438\u0448\u044C \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 \u0432 \u0432\u0430\u0441 \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0430\u0442\u044C \u0434\u043B\u044F \u0432\u0430\u0441 \u0440\u043E\u043A\u043E\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 70567816814592
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0410\u043F\u0442\u0435\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 70680580677632
    m_Localized: "\u0412\u044B \u0432\u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0435 {health} \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
