  - m_Id: 76011700445184
    m_Localized: "\u041D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 76081032290304
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 24637296295239680
    m_Localized: "\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0422\u0435\u043A\u0441\u0442\u0443\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 24637799422976000
    m_Localized: "\u041E\u043D\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0432\u0438\u0434\u0435\u0442\u044C \u0432\u0430\u0441, \u0432\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u0434\u0435\u0442\u044C \u0438\u0445. \u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0443\u0436\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0434\u0430\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0432\u044B \u043F\u0440\u043E\u043F\u0430\u0434\u0451\u0442\u0435 \u0441\u0430\u043C\u0438... \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 24638048178757632
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0438\u043A\u0442\u043E \u0432\u0430\u0441 \u043D\u0435 \u0432\u0438\u0434\u0438\u0442, \u0438 \u0432\u044B \u043D\u0438\u043A\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 24638443533852672
    m_Localized: "(\u041D\u0435)\u0443\u0434\u0430\u0447\u043D\u044B\u0439 \u0412\u044B\u0441\u0442\u0440\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 24639211494137856
    m_Localized: "\u041E\u0434\u043D\u043E\u043C\u0443 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C\u0443 \u0438\u0433\u0440\u043E\u043A\u0443 \u0438\u0437 \u0432\u0441\u0435\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0432\u0430\u0441 \u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u0451\u0442 \u0438 \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u0442 {damage} \u0435\u0434\u0438\u043D\u0438\u0446 \u0443\u0440\u043E\u043D\u0430 \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 24639686226436096
    m_Localized: "\u041E\u0434\u043D\u043E\u043C\u0443 \u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E \u0438 \u0442\u043E\u0442 \u043F\u0440\u0438\u043D\u044F\u043B \u0443\u0440\u043E\u043D, \u0432\u0441\u0451 \u0438\u0437-\u0437\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 24646271011086336
    m_Localized: "\u0421\u0442\u0432\u043E\u043B\u044B \u0411\u043B\u0438\u0437\u043D\u0435\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 24646440532271104
    m_Localized: "\u041E\u0440\u0443\u0436\u0438\u0435, \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044E\u0449\u0435\u0435 2 \u0432\u0437\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u0441\u043D\u0430\u0440\u044F\u0434\u0430. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0431\u043B\u0438\u0437\u043A\u0438\u0445 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 24647016879972352
    m_Localized: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u0443\u0448\u043A\u0443, \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 25105894847504384
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0410\u043F\u0442\u0435\u0447\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25106182220242944
    m_Localized: "\u0412\u044B \u0432\u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0435 {health} \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 25157885992853504
    m_Localized: "\u0411\u0430\u043D\u043A\u0430 \u041F\u043E\u0440\u043E\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25158317096001536
    m_Localized: "\u0412\u044B \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430, \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0440\u043E\u0445\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 25158649037414400
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0435 \u0413\u0443\u0441\u0435\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25158904093040640
    m_Localized: "\u0412\u044B \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u044B. \u0422\u044F\u0436\u0435\u043B\u0435\u0435 - \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442 \u0436\u0438\u0440\u043D\u0435\u0435, \u0442\u0430\u043A \u0432\u0435\u0434\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 25362945230200832
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u041F\u043E\u0433\u0440\u0443\u0437\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 25372714284310528
    m_Localized: "\u041F\u0447\u0435\u043B\u0438\u043D\u0430\u044F \u0411\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25372870668935168
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0437\u0430\u0449\u0438\u0442\u044B \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0447\u0442\u043E\u0431\u044B \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0432\u0441\u0435\u0445 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25373363868753920
    m_Localized: "\u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0437\u0430\u0449\u0438\u0442\u044B \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0435\u0445 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C. \u0412\u0441\u0451 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25751314284109824
    m_Localized: "\u0416\u0430\u0436\u0434\u0430 \u041A\u0440\u043E\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25751396253392896
    m_Localized: "\u0417\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 {interval} \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0435\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0432\u044B \u043F\u0440\u0438\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0435 {damage} \u0435\u0434\u0438\u043D\u0438\u0446 \u0443\u0440\u043E\u043D\u0430. \u041D\u043E \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u0438\u043D\u0430\u0447\u0435 \u0432\u044B \u0443\u043C\u0440\u0451\u0442\u0435."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 25753328636354560
    m_Localized: "\u0412\u044B \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u043F\u043E \u043C\u0435\u0440\u0435 \u043F\u043E\u0442\u0435\u0440\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 26193936811253760
    m_Localized: "\u0411\u043E\u043C\u0431\u043E\u043C\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 26194437552431104
    m_Localized: "\u041E\u0440\u0443\u0436\u0438\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043E\u0434\u043D\u0443 \u0431\u043E\u043C\u0431\u0443. \u041F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438, \u0431\u043E\u043C\u0431\u0430 \u0434\u0435\u0442\u043E\u043D\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u044F \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \u0432\u043E\u043A\u0440\u0443\u0433. \u041A\u0430\u0436\u0434\u044B\u0439 \u043E\u0441\u043A\u043E\u043B\u043E\u043A \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0443\u0440\u043E\u043D. \u0414\u0430\u043D\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 26196113726332928
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u044C\u043D\u0438\u0442\u0435 \u0440\u0430\u0437\u043E\u043A, \u043D\u043E \u043B\u044E\u0431\u043E\u0435 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043A \u0432\u0437\u0440\u044B\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 26441192122572800
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 26441382044852224
    m_Localized: "\u042D\u0442\u043E \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D\u0430, \u043D\u043E \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u043E\u043D\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438\u0433\u0440\u043E\u043A\u0430 \u043D\u0430 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434. \u0414\u0430\u043D\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 26442908607930368
    m_Localized: "\u0412\u044B \u043D\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0443\u0440\u043E\u043D\u0430, \u043D\u043E \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0437\u0430\u043C\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0435 \u0442\u043E\u0433\u043E, \u0432 \u043A\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 26924141402087424
    m_Localized: "\u0418\u0441\u0442\u0438\u043D\u044B\u0439 \u0411\u0430\u043B\u0430\u043D\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 26924559217680384
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442\u0435, \u0432\u0441\u0435 \u0438\u0433\u0440\u043E\u043A\u0438 \u043A\u0440\u043E\u043C\u0435 \u0432\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 {heal} \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F. \u041D\u0430 \u0438\u0433\u0440\u043E\u043A\u043E\u0432, \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0435\u0441\u0442\u044C \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u044D\u0442\u043E \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442. \u0412\u0430\u0448\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0443\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0432\u044B \u0434\u0430\u0451\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u0447\u0435\u043C \u043F\u0440\u043E\u043C\u0430\u0445\u043E\u0432."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 26926915934183424
    m_Localized: "\u0414\u0440\u0443\u0433\u0438\u0435 \u043B\u0435\u0447\u044F\u0442\u0441\u044F \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442\u0435, \u043D\u043E \u0432\u044B \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442\u0435 \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 27916745065324544
    m_Localized: "\u0412\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0435\u0434\u0438\u043D\u0438\u0446 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F!"
    m_Metadata:
