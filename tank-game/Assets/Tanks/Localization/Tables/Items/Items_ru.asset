    m_Localized: "\u041F\u043E\u0434\u0443\u0448\u0435\u0447\u043D\u0430\u044F \u0417\u0430\u0449\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690560
    m_Localized: "\u041D\u0435 \u043F\u043E\u0434\u0443\u0448\u043A\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0432\u0441\u0451 \u0436\u0435, \u043D\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690561
    m_Localized: "\u0412\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0435 \u0437\u0430\u0449\u0438\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690562
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u0437\u043A\u043E\u0435 \u041C\u044B\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690563
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u044C\u0442\u0435\u0441\u044C, \u0432\u044B \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u044D\u0444\u0444\u0435\u043A\u0442 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0435\u0437\u0434\u044B \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690564
    m_Localized: "\u0412\u044B \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043D\u043E \u0442\u0435\u0440\u044F\u0435\u0442\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690565
    m_Localized: "\u0420\u0436\u0430\u0432\u0430\u044F \u0417\u0430\u043F\u0447\u0430\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690566
    m_Localized: "\u041D\u0435 \u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0435\u0451 \u0440\u0436\u0430\u0432\u0447\u0438\u043D\u0443, \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690567
    m_Localized: "\u0412\u044B \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690571
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0441 \u0410\u0434\u0440\u0435\u043D\u0430\u043B\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690572
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0443 \u0432\u0430\u0441 \u043C\u0435\u043D\u044C\u0448\u0435 {health-threshold} \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0432\u044B \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043D\u0430 {duration} \u0441\u0435\u043A\u0443\u043D\u0434. \u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u0437\u0430 \u0440\u0430\u0443\u043D\u0434."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 34421328138690573
    m_Localized: "\u0411\u0435\u0433\u0441\u0442\u0432\u043E \u0438\u043B\u0438 \u0431\u043E\u0439 \u043D\u0430 \u043F\u043E\u0440\u043E\u0433\u0435 \u0443 \u0441\u043C\u0435\u0440\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690574
    m_Localized: "\u0420\u0435-\u0420\u0435\u0420\u043E\u043B\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690575
    m_Localized: "\u042D\u0442\u0430 \u0448\u0442\u0443\u043A\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0438 \u0441\u0442\u0430\u0442\u044B \u043A\u0430\u0436\u0434\u044B\u0435 {interval} \u0441\u0435\u043A\u0443\u043D\u0434. \u0421\u0442\u0430\u0442\u044B \u0441\u043E \u0437\u043D\u0430\u0447\u043D\u0438\u0435\u043C \u043D\u043E\u043B\u044C \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u044E\u0442\u0441\u044F \u0438 \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u044E\u0442\u0441\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044E. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u0430\u0442\u044B \u043C\u043E\u0433\u0443\u0442 \u0443\u043F\u0435\u0440\u0435\u0442\u044C\u0441\u044F \u0432 \u043F\u0440\u0435\u0434\u0435\u043B."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 34421328138690576
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0430\u0448\u0438 \u0441\u0442\u0430\u0442\u044B \u0436\u0438\u0432\u0443\u0442 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 34446604776202240
    m_Localized: "\u0421\u0442\u0430\u0442\u043E\u0444\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 34446604822339584
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0435 {interval} \u0441\u0435\u043A\u0443\u043D\u0434, \u0432\u0430\u0448\u0438 \u0441\u0442\u0430\u0442\u044B \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438. \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u0430 \u0441\u0442\u0430\u0442\u0430 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0430 \u0437\u0430 \u0440\u0430\u0437, \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432 \u0431\u044B\u043B\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435. \u041F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0441\u0442\u0430\u0442\u044B, \u043A\u0440\u0443\u0433 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442\u0441\u044F \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u0441\u0442\u0430\u0442\u044B."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 34446604822339585
    m_Localized: "\u0412\u0435\u0434\u044C \u0434\u0430\u0436\u0435 \u0441\u0442\u0430\u0442\u044B \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0434 \u0442\u0440\u0430\u0444\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 34446604822339586
    m_Localized: "\u0420\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0414\u041D\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 34446604822339587
    m_Localized: "\u041F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u043E\u0434\u043D\u0443 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0443\u044E \u0441\u0442\u0430\u0442\u0443 \u0438 \u043F\u043E\u043D\u0438\u0436\u0430\u0435\u0442 \u0434\u0440\u0443\u0433\u0443\u044E.\n\n\u0423\u0440\u043E\u043D, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C: {damage-boost} / {damage-penalty}.\n\u0417\u0430\u0449\u0438\u0442\u0430: {defense-boost} / {defense-penalty}.\n\u0421\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435: {resistance-boost} / {resistance-penalty}."
    m_Metadata:
      m_Items:
      - rid: 937747718553469027
  - m_Id: 34446604822339588
    m_Localized: "\u0423 \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u0438 \u0435\u0441\u0442\u044C \u0446\u0435\u043D\u0430."
