%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Items_fr
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 72df8041cb1f65b40958c98981ef1561, type: 2}
  m_Metadata:
    m_Items:
    - rid: 5824281740147687477
  m_TableData:
  - m_Id: 27924629891276800
    m_Localized: "Vous avez ramass\xE9 {item}"
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 70680580677632
    m_Localized: "Vous restaurez {health} unit\xE9s de sant\xE9."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 25106182220242944
    m_Localized: "Vous restaurez {health} unit\xE9s de sant\xE9."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 24639211494137856
    m_Localized: "Un joueur choisi au hasard parmi tous les joueurs, vous y compris, subit {damage} d\xE9g\xE2ts de mani\xE8re inattendue. Il lui reste 1 point de vie si ces d\xE9g\xE2ts \xE9taient mortels."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 25751396253392896
    m_Localized: "Pour chaque {interval} de sant\xE9 manquante, vous subissez {damage} points de d\xE9g\xE2ts. Cependant, cet objet ne peut \xEAtre ramass\xE9 qu'une seule fois, sinon vous mourrez."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 26924559217680384
    m_Localized: "\xC0 chaque tir, tous les joueurs, sauf vous, r\xE9cup\xE8rent {heal} points de vie. Les joueurs \xE9quip\xE9s de cet objet ne sont pas affect\xE9s. Votre cadence de tir est doubl\xE9e. Veillez \xE0 infliger plus de d\xE9g\xE2ts que vous n'en ratez."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 75812378730496
    m_Localized: Inhabituel
    m_Metadata:
      m_Items: []
  - m_Id: 75907253886976
    m_Localized: Rare
    m_Metadata:
      m_Items: []
  - m_Id: 75961305882624
    m_Localized: "\xC9pique"
    m_Metadata:
      m_Items: []
  - m_Id: 76011700445184
    m_Localized: Instable
    m_Metadata:
      m_Items: []
  - m_Id: 76081032290304
    m_Localized: "L\xE9gendaire"
    m_Metadata:
      m_Items: []
  - m_Id: 1898613006336
    m_Localized: "Pas de droit \xE0 l'erreur"
    m_Metadata:
      m_Items: []
  - m_Id: 2067794452480
    m_Localized: "Vous infligez des d\xE9g\xE2ts absurdes, mais un seul coup peut vous \xEAtre fatal."
    m_Metadata:
      m_Items: []
  - m_Id: 73022222852096
    m_Localized: Tuer ou mourir. Aucune marge d'erreur...
    m_Metadata:
      m_Items: []
  - m_Id: 70567816814592
    m_Localized: Grande trousse de soin
    m_Metadata:
      m_Items: []
  - m_Id: 27916745065324544
    m_Localized: "Vous avez recouvr\xE9 une grande partie de votre sant\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 25105894847504384
    m_Localized: Petite trousse de soin
    m_Metadata:
      m_Items: []
  - m_Id: 27916975806570496
    m_Localized: "Vous avez restaur\xE9 des points de vie !"
    m_Metadata:
      m_Items: []
  - m_Id: 71017257459712
    m_Localized: "T\xE9l\xE9portation - Al\xE9atoire"
    m_Metadata:
      m_Items: []
  - m_Id: 71319167655936
    m_Localized: "Envie de sensations fortes\_? T\xE9l\xE9portez-vous vers un lieu al\xE9atoire, m\xEAme en zone dangereuse."
    m_Metadata:
      m_Items: []
  - m_Id: 74540846112768
    m_Localized: "Une \xE9vasion qui a un hic. Un hic accidentel, en r\xE9alit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 71503196938240
    m_Localized: Arme automatique
    m_Metadata:
      m_Items: []
  - m_Id: 71606984990720
    m_Localized: "Une arme dot\xE9e d'une cadence de tir nettement sup\xE9rieure, mais infligeant beaucoup moins de d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 75199460892672
    m_Localized: Cette arme tire incroyablement vite.
    m_Metadata:
      m_Items: []
  - m_Id: 24637296295239680
    m_Localized: Texture manquante
    m_Metadata:
      m_Items: []
  - m_Id: 24637799422976000
    m_Localized: "Ils ne peuvent pas vous voir, vous ne pouvez pas les voir. Si vous poss\xE9dez d\xE9j\xE0 cet objet, vous dispara\xEEtrez vous-m\xEAme\u2026 Au moins, vous gagnerez en vitesse."
    m_Metadata:
      m_Items: []
  - m_Id: 24638048178757632
    m_Localized: Maintenant, personne ne vous voit, et vous ne voyez personne.
    m_Metadata:
      m_Items: []
  - m_Id: 24638443533852672
    m_Localized: Coup (mal)chanceux
    m_Metadata:
      m_Items: []
  - m_Id: 24639686226436096
    m_Localized: "L'un d'eux a eu la malchance de subir des d\xE9g\xE2ts, et tout cela \xE0 cause de vous."
    m_Metadata:
      m_Items: []
  - m_Id: 24646271011086336
    m_Localized: Coffres jumeaux
    m_Metadata:
      m_Items: []
  - m_Id: 24646440532271104
    m_Localized: "Une arme tirant deux projectiles explosifs. Id\xE9ale pour le combat rapproch\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 24647016879972352
    m_Localized: "Vous avez obtenu une grosse arme qui inflige de gros d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 25157885992853504
    m_Localized: "Bo\xEEte de poudre \xE0 canon"
    m_Metadata:
      m_Items: []
  - m_Id: 25158317096001536
    m_Localized: "Plus vous infligez de d\xE9g\xE2ts, plus vous utilisez de poudre !"
    m_Metadata:
      m_Items: []
  - m_Id: 25158649037414400
    m_Localized: Marches lourdes
    m_Metadata:
      m_Items: []
  - m_Id: 25158904093040640
    m_Localized: "Vous \xEAtes plus lourd, mais vous \xEAtes mieux prot\xE9g\xE9. Plus lourd ne veut pas dire plus gros, n'est-ce pas ?"
    m_Metadata:
      m_Items: []
  - m_Id: 25362945230200832
    m_Localized: Chargeur rapide
    m_Metadata:
      m_Items: []
  - m_Id: 27918120339857408
    m_Localized: Vous tirez un peu plus vite que d'habitude.
    m_Metadata:
      m_Items: []
  - m_Id: 25372714284310528
    m_Localized: Armure d'abeille
    m_Metadata:
      m_Items: []
  - m_Id: 25372870668935168
    m_Localized: "Gagnez temporairement suffisamment de protection et de vitesse pour an\xE9antir tous les ennemis sur la carte."
    m_Metadata:
      m_Items: []
  - m_Id: 25373363868753920
    m_Localized: "Vous avez acquis suffisamment de protection et de vitesse pour tous les an\xE9antir. Ce n'est que le d\xE9but."
    m_Metadata:
      m_Items: []
  - m_Id: 25751314284109824
    m_Localized: Soif de sang
    m_Metadata:
      m_Items: []
  - m_Id: 25753328636354560
    m_Localized: "Vous infligez plus de d\xE9g\xE2ts \xE0 mesure que votre sant\xE9 diminue."
    m_Metadata:
      m_Items: []
  - m_Id: 26193936811253760
    m_Localized: Lance-bombes
    m_Metadata:
      m_Items: []
  - m_Id: 26194437552431104
    m_Localized: "Arme tirant une bombe. \xC0 l'impact, la bombe explose et projette une multitude d'\xE9clats. Chaque \xE9clat inflige de l\xE9gers d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 26196113726332928
    m_Localized: Un seul tir suffit, mais toute collision provoquera une explosion.
    m_Metadata:
      m_Items: []
  - m_Id: 26441192122572800
    m_Localized: Pistolet Frigorifique
    m_Metadata:
      m_Items: []
  - m_Id: 26441382044852224
    m_Localized: "Cette arme n'inflige pas de d\xE9g\xE2ts. Le joueur touch\xE9 subit l'effet de statut {effect-frozen} pendant quelques secondes."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 26442908607930368
    m_Localized: "Vous n'infligez aucun d\xE9g\xE2t, mais vous immobilisez instantan\xE9ment toute personne touch\xE9e une fois."
    m_Metadata:
      m_Items: []
  - m_Id: 26924141402087424
    m_Localized: "Un v\xE9ritable \xE9quilibre ?"
    m_Metadata:
      m_Items: []
  - m_Id: 26926915934183424
    m_Localized: "Les autres gu\xE9rissent quand vous tirez, mais vous tirez plus vite."
    m_Metadata:
      m_Items: []
  - m_Id: 27924629891276801
    m_Localized: "a ramass\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328096747520
    m_Localized: Protection du coussin
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690560
    m_Localized: "Ce n'est pas un coussin de s\xE9curit\xE9, mais c'est utile."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690561
    m_Localized: "Vous augmentez l\xE9g\xE8rement votre d\xE9fense."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690562
    m_Localized: Savon glissant
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690563
    m_Localized: "Croyez-moi, vous en ressentirez l'effet en conduisant vers l'avant et en tirant vers l'arri\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690564
    m_Localized: "Vous augmentez votre vitesse mais perdez en r\xE9sistance."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690565
    m_Localized: "Pi\xE8ce de rechange rouill\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690566
    m_Localized: "Malgr\xE9 sa rouille, vous causerez plus de d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690567
    m_Localized: "Vous infligez l\xE9g\xE8rement plus de d\xE9g\xE2ts."
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690571
    m_Localized: "Pouss\xE9e d'adr\xE9naline"
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690572
    m_Localized: "Lorsque vos points de vie sont inf\xE9rieurs \xE0 {health-threshold}, votre vitesse et votre cadence de tir augmentent pendant {duration}. Cet effet ne s'applique qu'une seule fois par manche."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 34421328138690573
    m_Localized: Fuir ou combattre au seuil de la mort.
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690574
    m_Localized: Re-Relancer
    m_Metadata:
      m_Items: []
  - m_Id: 34421328138690575
    m_Localized: "Ce syst\xE8me m\xE9lange vos stats toutes les {interval}. Les stats avec une valeur de z\xE9ro sont ignor\xE9es et ne sont pas affect\xE9es. Certaines peuvent atteindre la limite."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 34421328138690576
    m_Localized: Maintenant, vos stats vivent leur vie.
    m_Metadata:
      m_Items: []
  - m_Id: 34446604776202240
    m_Localized: Feu des stats
    m_Metadata:
      m_Items: []
  - m_Id: 34446604822339584
    m_Localized: "Toutes les {interval}, vos stats augmentent tour \xE0 tour. Une seule stat peut \xEAtre active \xE0 la fois, les stats pr\xE9c\xE9dentes reviennent \xE0 leur \xE9tat initial. Apr\xE8s la derni\xE8re stat, le cycle recommence avec la premi\xE8re."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 34446604822339585
    m_Localized: "Apr\xE8s tout, m\xEAme les stats sont ajust\xE9es en fonction du trafic."
    m_Metadata:
      m_Items: []
  - m_Id: 34446604822339586
    m_Localized: Reconstruction de l'ADN
    m_Metadata:
      m_Items: []
  - m_Id: 34446604822339587
    m_Localized: "Augmente une stat al\xE9atoire et diminue une autre.\n\nD\xE9g\xE2ts, vitesse et cadence de tir\_: {damage-boost} / {damage-penalty}.\nD\xE9fense\_: {defense-boost} / {defense-penalty}.\nR\xE9sistance\_: {resistance-boost} / {resistance-penalty}."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 34446604822339588
    m_Localized: "L'\xE9volution a un prix."
    m_Metadata:
      m_Items: []
  - m_Id: 35240567506427904
    m_Localized: "Fournitures dans le r\xE9frig\xE9rateur"
    m_Metadata:
      m_Items: []
  - m_Id: 35240567560953856
    m_Localized: "Chaque fois que vous gagnez des points de vie, votre stat la plus basse augmente {increase} et votre stat la plus \xE9lev\xE9e diminue {decrease}."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35240567560953857
    m_Localized: Deux pour le prix d'un.
    m_Metadata:
      m_Items: []
  - m_Id: 35299638754369538
    m_Localized: Niveau MAX
    m_Metadata:
      m_Items: []
  - m_Id: 35299638754369539
    m_Localized: Toutes vos stats sont au maximum pendant {duration}.
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35299638754369540
    m_Localized: "Oui, c'est parfaitement l\xE9gal."
    m_Metadata:
      m_Items: []
  - m_Id: 35315045817081856
    m_Localized: Coup de chance
    m_Metadata:
      m_Items: []
  - m_Id: 35315045817081857
    m_Localized: "Chaque troisi\xE8me coup port\xE9 par vous inflige {damage} d\xE9g\xE2ts suppl\xE9mentaires."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35315045817081858
    m_Localized: "Infligez plus de d\xE9g\xE2ts \xE0 chaque troisi\xE8me coup."
    m_Metadata:
      m_Items: []
  - m_Id: 35493227904065536
    m_Localized: "\xC9pines"
    m_Metadata:
      m_Items: []
  - m_Id: 35493227946008576
    m_Localized: "Chaque fois que vous subissez des d\xE9g\xE2ts, {damage} de ces d\xE9g\xE2ts sont renvoy\xE9s \xE0 celui qui a d\xE9cid\xE9 de vous nuire."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35493227946008577
    m_Localized: "M\xEAme ce jeu a une commission."
    m_Metadata:
      m_Items: []
  - m_Id: 35493227946008578
    m_Localized: "Limite de vitesse n\xE9gative"
    m_Metadata:
      m_Items: []
  - m_Id: 35493227946008579
    m_Localized: "Vous subissez {damage} d\xE9g\xE2ts chaque fois que vous avancez, mais les d\xE9g\xE2ts que vous vous infligez sont r\xE9duits de {decrease}."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35493227946008580
    m_Localized: "Tech r\xE9trograde - Meilleure tech."
    m_Metadata:
      m_Items: []
  - m_Id: 35508022451593216
    m_Localized: "\u0152uf de poule"
    m_Metadata:
      m_Items: []
  - m_Id: 35508022451593217
    m_Localized: "Infligez {damage} d\xE9g\xE2ts suppl\xE9mentaires si le joueur touch\xE9 a {threshold} points de vie ou plus."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35508022451593218
    m_Localized: Il ne faut surtout pas rater le premier.
    m_Metadata:
      m_Items: []
  - m_Id: 35511987285221376
    m_Localized: Conscient de soi
    m_Metadata:
      m_Items: []
  - m_Id: 35511987289415680
    m_Localized: "Vous tirez \xE0 une vitesse incroyable, mais les d\xE9g\xE2ts que vous vous infligez sont augment\xE9s par {damage}."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 35511987289415681
    m_Localized: "Le droit \xE0 l'erreur existe, existe..."
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000000
    m_Localized: Sac de fille
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000001
    m_Localized: "Contient tout le n\xE9cessaire. Augmente toutes vos stats sauf la vitesse de {increase}, mais diminue votre vitesse de {decrease}. Car il est lourd."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000002
    m_Localized: "Capacit\xE9 adapt\xE9e \xE0 toutes les occasions."
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000003
    m_Localized: "Canap\xE9 cool"
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000004
    m_Localized: "Toutes les {interval} d'immobilit\xE9, votre stat la plus \xE9lev\xE9e augmente de {increase}. Si elle atteint son maximum, c'est la stat imm\xE9diatement sup\xE9rieure qui augmente. D\xE9placer ou faire pivoter le char r\xE9initialise le chronom\xE8tre."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000005
    m_Localized: "Asseyez-vous, d\xE9tendez-vous, pr\xE9parez-vous une tasse de th\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000006
    m_Localized: Noclip
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000007
    m_Localized: "Vous pouvez traverser les murs pendant {duration}. Durant cet effet, vous ne pouvez pas tirer, mais vous pouvez subir des d\xE9g\xE2ts. Si vous vous trouvez \xE0 l'int\xE9rieur d'un mur \xE0 la fin de l'effet, vous serez instantan\xE9ment d\xE9truit."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000008
    m_Localized: Vous traversez les murs.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000009
    m_Localized: Comme un diamant
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000010
    m_Localized: Vous brillez de mille feux et attires l'attention des autres joueurs. Cependant, avec de telles stats, vous savez vous comporter avec eux.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000011
    m_Localized: Il m'est impossible de ne pas vous regarder.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000012
    m_Localized: Fleur des bienfaits
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000013
    m_Localized: "Fait preuve de bienveillance et applique {effect-healing} \xE0 tous les joueurs, y compris vous, pendant {duration}."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000014
    m_Localized: "La paix \xE9tait une des options."
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000015
    m_Localized: Sans honneur
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000016
    m_Localized: "Vous infligez {increase} plus de d\xE9g\xE2ts lorsque vous frappez un joueur dans le dos."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000017
    m_Localized: Soyez sur vos gardes.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000018
    m_Localized: Boule de feu
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000019
    m_Localized: "Lance une gigantesque boule de feu. Chaque impact provoque une puissante explosion infligeant des d\xE9g\xE2ts consid\xE9rables. Les joueurs proches de l'explosion subissent l'effet {effect-burning}."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000020
    m_Localized: Les choses vont chauffer ici.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000021
    m_Localized: Gratos
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000022
    m_Localized: "Cette arme n'inflige aucun d\xE9g\xE2t. \xC0 l'impact, elle fait appara\xEEtre un objet al\xE9atoire de niveau al\xE9atoire, \xE0 l'exclusion des objets rares et l\xE9gendaires."
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000023
    m_Localized: "Tout doit \xEAtre vendu."
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000024
    m_Localized: Boules chaudes
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000025
    m_Localized: "Cette arme tire de minuscules billes qui provoquent un effet de br\xFBlure \xE0 l'impact."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000026
    m_Localized: Petit mais tranchant.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000027
    m_Localized: Hibernation
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000028
    m_Localized: "Active l'effet {effect-frozen} pendant {duration}. Ensuite, votre sant\xE9 est enti\xE8rement restaur\xE9e. D\xE9geler l'effet pr\xE9matur\xE9ment annule la gu\xE9rison."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000029
    m_Localized: Dors un peu.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000030
    m_Localized: "Diminution de l'\xE9quilibre"
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000031
    m_Localized: "Tirer avec votre sant\xE9 au-dessus de {threshold} vous inflige l'effet {effect-burning} pendant {duration}. Chaque deuxi\xE8me coup direct port\xE9 \xE0 un autre joueur inflige {incre} de d\xE9g\xE2ts suppl\xE9mentaires."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000032
    m_Localized: La douleur porte ses fruits.
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000033
    m_Localized: Retrofire
    m_Metadata:
      m_Items: []
  - m_Id: 36000000000000034
    m_Localized: "Vous perdez des FPS, mais une stat augmente consid\xE9rablement. Vous ne pouvez ramasser cet objet que deux fois.\n\nPremi\xE8re fois\_: d\xE9fense {first}, FPS maximum.\nDeuxi\xE8me fois\_: d\xE9g\xE2ts {second}, FPS maximum.\nTroisi\xE8me fois\_: vous mourez."
    m_Metadata:
      m_Items:
      - rid: 5824281740147687477
  - m_Id: 36000000000000035
    m_Localized: "Avez-vous d\xE9j\xE0 vu \xE7a dans des jeux ?"
    m_Metadata:
      m_Items: []
  - m_Id: 38550435874512896
    m_Localized: Grenade flash
    m_Metadata:
      m_Items: []
  - m_Id: 38550435912261632
    m_Localized: "Une arme qui tire une grenade flashbang. Tout impact provoque l'effet {effect-flashed} sur les joueurs, y compris vous. La grenade n'inflige pas de d\xE9g\xE2ts et n'aveugle pas les joueurs cach\xE9s derri\xE8re des obstacles."
    m_Metadata:
      m_Items: []
  - m_Id: 38550435912261633
    m_Localized: Mais ne vous aveuglez pas.
    m_Metadata:
      m_Items: []
