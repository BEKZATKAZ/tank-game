  m_TableData:
  - m_Id: 22173671424
    m_Localized: "\u041F\u041E\u0414\u0422\u0412\u0415\u0420\u0414\u0418\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 286872002560
    m_Localized: "\u041D\u0438\u043A\u043D\u0435\u0439\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 979284484096
    m_Localized: "\u0412\u042B\u0411\u0415\u0420\u0418\u0422\u0415 \u0421\u0415\u0411\u0415 \u041D\u0418\u041A\u041D\u0415\u0419\u041C"
    m_Metadata:
      m_Items: []
  - m_Id: 23467932791562240
    m_Localized: "\u041F\u0420\u0415\u0414\u0423\u041F\u0420\u0415\u0416\u0414\u0415\u041D\u0418\u0415 \u041E \u0412\u0420\u0415\u0414\u0415 \u0414\u041B\u042F \u0417\u0414\u041E\u0420\u041E\u0412\u042C\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 23467932837699584
    m_Localized: "\u042D\u0442\u0430 \u0438\u0433\u0440\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u0438\u0433\u0430\u044E\u0449\u0438\u0435 \u043E\u0433\u043D\u0438 \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043A\u0430\u043C\u0435\u0440\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442, \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435, \u0442\u043E\u0448\u043D\u043E\u0442\u0443 \u0438\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0434\u043A\u0438 \u0443 \u043B\u044E\u0434\u0435\u0439 \u0441 \u0444\u043E\u0442\u043E\u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0439 \u044D\u043F\u0438\u043B\u0435\u043F\u0441\u0438\u0435\u0439. \u0415\u0441\u043B\u0438 \u0432\u044B \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435, \u0442\u043E\u0448\u043D\u043E\u0442\u0443, \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0437\u0440\u0435\u043D\u0438\u044F, \u0434\u0435\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044E \u0438\u043B\u0438 \u043A\u0430\u043A\u0438\u0435-\u043B\u0438\u0431\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0441\u0438\u043C\u043F\u0442\u043E\u043C\u044B \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B, \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 23510397867220992
    m_Localized: "\u042F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B(\u0430) \u0438 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u044E\u0441\u044C \u0441 [\u041F\u043E\u043B\u0438\u0442\u0438\u043A\u043E\u0439 \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438]."
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000000
    m_Localized: 'ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ'
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000001
    m_Localized: 'Проверка политики и подключение...'
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000002
    m_Localized: 'Не удалось продолжить. Проверьте соединение и повторите попытку. Вход недоступен до проверки и принятия текущей политики.'
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000003
    m_Localized: 'Я прочитал(а) и принимаю эту Политику конфиденциальности.'
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000004
    m_Localized: 'ПРОДОЛЖИТЬ'
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000005
    m_Localized: 'ПОВТОРИТЬ'
    m_Metadata:
      m_Items: []
  - m_Id: 23520000000000006
    m_Localized: 'ВЫЙТИ'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
